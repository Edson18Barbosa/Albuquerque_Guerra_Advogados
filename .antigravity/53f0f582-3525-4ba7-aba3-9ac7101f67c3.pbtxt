    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Target, Compass, Sparkles } from \'lucide-react\';\n\nexport const MissionVision: React.FC = () => {\n  const [activeMode, setActiveMode] = useState<\'missao\' | \'visao\'>(\'missao\');\n\n  return (\n    <section id=\"missao-visao\" className=\"py-24 md:py-32 bg-[#101616] relative overflow-hidden\">\n      <div className=\"absolute inset-0 opacity-[0.02] bg-[radial-gradient(#D8CBB3_1px,transparent_1px)] [background-size:32px_32px] pointer-events-none\" />\n\n      <div className=\"max-w-7xl mx-auto px-6 md:px-12 relative z-10\">\n        \n        {/* Section Header */}\n        <div className=\"text-center max-w-3xl mx-auto mb-16\">\n          <span className=\"text-[#D8CBB3] font-serif text-sm tracking-widest block mb-3\">\n            05 / PROP\303\223SITO E DIRE\303\207\303\203O\n          </span>\n          <h2 className=\"text-3xl sm:text-4xl md:text-5xl font-serif text-[#FFFDF8] font-light mb-6\">\n            Miss\303\243o & <span className=\"text-[#D8CBB3] italic\">Vis\303\243o.</span>\n          </h2>\n          <p className=\"text-[#F6F3EC]/80 text-base md:text-lg font-light\">\n            O norte que orienta cada decis\303\243o, contrato e atua\303\247\303\243o processual do nosso escrit\303\263rio.\n          </p>\n        </div>\n\n        {/* Switcher Buttons */}\n        <div className=\"flex items-center justify-center gap-4 mb-12\">\n          <button\n            onClick={() => setActiveMode(\'missao\')}\n            className={`px-8 py-4 rounded-2xl text-base font-medium transition-all duration-300 flex items-center gap-3 border ${\n              activeMode === \'missao\'\n                ? \'bg-[#D8CBB3] text-[#101616] border-[#D8CBB3] shadow-lg scale-105\'\n                : \'bg-[#151f1f] text-[#F6F3EC] border-[#D8CBB3]/20 hover:border-[#D8CBB3]/60\'\n            }`}\n          >\n            <Target className=\"w-5 h-5\" />\n            <span>Nossa Miss\303\243o</span>\n          </button>\n\n          <button\n            onClick={() => setActiveMode(\'visao\')}\n            className={`px-8 py-4 rounded-2xl text-base font-medium transition-all duration-300 flex items-center gap-3 border ${\n              activeMode === \'visao\'\n                ? \'bg-[#D8CBB3] text-[#101616] border-[#D8CBB3] shadow-lg scale-105\'\n                : \'bg-[#151f1f] text-[#F6F3EC] border-[#D8CBB3]/20 hover:border-[#D8CBB3]/60\'\n            }`}\n          >\n            <Compass className=\"w-5 h-5\" />\n            <span>Nossa Vis\303\243o</span>\n          </button>\n        </div>\n\n        {/* Content Display Card */}\n        <div className=\"p-8 md:p-14 rounded-3xl bg-[#151f1f]/90 border border-[#D8CBB3]/30 shadow-2xl relative overflow-hidden animate-fadeIn\">\n          \n          {activeMode === \'missao\' ? (\n            <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-10 items-center\">\n              <div className=\"lg:col-span-8 space-y-6\">\n                <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#374544] text-[#D8CBB3] text-xs font-semibold tracking-wider uppercase border border-[#D8CBB3]/30\">\n                  <Sparkles className=\"w-3.5 h-3.5\" />\n                  <span>Miss\303\243o Institucional</span>\n                </div>\n\n                <h3 className=\"text-2xl sm:text-3xl md:text-4xl font-serif text-[#FFFDF8] leading-tight\">\n                  Vantajosidade e impacto positivo para o cliente.\n                </h3>\n\n                <div className=\"space-y-4 text-[#F6F3EC]/90 text-base md:text-lg font-light leading-relaxed\">\n                  <p>\n                    Nossa miss\303\243o, em breves palavras, \303\251 buscar vantajosidade e impacto positivo para o nosso cliente. Para tanto, nossa atua\303\247\303\243o ocorre no contencioso e no consultivo jur\303\255dico.\n                  </p>\n                  <p>\n                    No <strong className=\"font-semibold text-[#FFFDF8]\">contencioso</strong>, utilizamos estrategicamente todas as ferramentas disponibilizadas pela legisla\303\247\303\243o processual para que a resolu\303\247\303\243o dos conflitos ocorra da forma mais vantajosa poss\303\255vel. Buscamos a exata medida da pretens\303\243o.\n                  </p>\n                  <p>\n                    No <strong className=\"font-semibold text-[#FFFDF8]\">consultivo</strong>, oferecemos orienta\303\247\303\243o jur\303\255dica para que as rela\303\247\303\265es sejam estabelecidas com seguran\303\247a, previsibilidade e impacto positivo de natureza econ\303\264mica, pessoal, reputacional, ambiental e social.\n                  </p>\n                </div>\n              </div>\n\n              <div className=\"lg:col-span-4 flex items-center justify-center\">\n                <div className=\"p-8 rounded-2xl bg-[#101616] border border-[#D8CBB3]/30 text-center space-y-4 shadow-xl\">\n                  <div className=\"w-16 h-16 rounded-2xl bg-[#374544] mx-auto flex items-center justify-center text-[#D8CBB3] border border-[#D8CBB3]/30\">\n                    <Target className=\"w-8 h-8\" />\n                  </div>\n                  <h4 className=\"font-serif text-xl text-[#FFFDF8]\">Foco no Resultado</h4>\n                  <p className=\"text-xs text-[#F6F3EC]/70 leading-relaxed\">\n                    Solu\303\247\303\265es jur\303\255dicas que geram valor real para neg\303\263cios, pessoas e comunidades.\n                  </p>\n                </div>\n              </div>\n            </div>\n          ) : (\n            <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-10 items-center\">\n              <div className=\"lg:col-span-8 space-y-6\">\n                <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#374544] text-[#D8CBB3] text-xs font-semibold tracking-wider uppercase border border-[#D8CBB3]/30\">\n                  <Sparkles className=\"w-3.5 h-3.5\" />\n                  <span>Vis\303\243o de Futuro</span>\n                </div>\n\n                <h3 className=\"text-2xl sm:text-3xl md:text-4xl font-serif text-[#FFFDF8] leading-tight\">\n                  A advocacia como instrumento de transforma\303\247\303\243o positiva da sociedade.\n                </h3>\n\n                <div className=\"space-y-4 text-[#F6F3EC]/90 text-base md:text-lg font-light leading-relaxed\">\n                  <p>\n                    Entendemos que a advocacia \303\251 instrumental e deve ter seu uso orientado para a transforma\303\247\303\243o positiva da sociedade. Buscamos ser protagonistas nesse processo, com reconhecimento e notoriedade em n\303\255vel nacional.\n                  </p>\n                  <p>\n                    Enxergamos uma sociedade em que a iniciativa privada, representada pelo Segundo e Terceiro Setores, seja forte, aut\303\264noma, participativa e preocupada com as comunidades em que atua.\n                  </p>\n                  <p>\n                    Nosso objetivo principal \303\251 atuar para que a advocacia sirva como instrumento na implementa\303\247\303\243o desse modelo ideal, onde autonomia, responsabilidade e engajamento c\303\255vico constroem um futuro melhor.\n                  </p>\n                </div>\n              </div>\n\n              <div className=\"lg:col-span-4 flex items-center justify-center\">\n                <div className=\"p-8 rounded-2xl bg-[#101616] border border-[#D8CBB3]/30 text-center space-y-4 shadow-xl\">\n                  <div className=\"w-16 h-16 rounded-2xl bg-[#374544] mx-auto flex items-center justify-center text-[#D8CBB3] border border-[#D8CBB3]/30\">\n                    <Compass className=\"w-8 h-8\" />\n                  </div>\n                  <h4 className=\"font-serif text-xl text-[#FFFDF8]\">Protagonismo Social</h4>\n                  <p className=\"text-xs text-[#F6F3EC]/70 leading-relaxed\">\n                    Iniciativa privada forte, aut\303\264noma e engajada no desenvolvimento comunit\303\241rio.\n                  </p>\n                </div>\n              </div>\n            </div>\n          )}\n\n        </div>\n\n      </div>\n    </section>\n  );\n};\n"
    }
