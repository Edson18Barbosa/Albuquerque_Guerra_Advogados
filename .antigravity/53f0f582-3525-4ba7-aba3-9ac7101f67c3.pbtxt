  file_change {
    absolute_path_uri: "file:///src/components/EventsSection.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { ArrowRight, Calendar, MapPin, Clock } from \'lucide-react\';\nimport { mockEvents, mockMedia } from \'../data/mockEvents\';\nimport { Event } from \'../types/events\';\n\nexport const EventsSection: React.FC = () => {\n  const [filter, setFilter] = useState(\'Todos\');\n\n  const categories = [\'Todos\', \'Pr\303\263ximos eventos\', \'Eventos realizados\', \'Palestras\', \'Congressos\', \'Cursos\', \'Workshops\', \'Outros\'];\n\n  // Sorting: Upcoming first, then past\n  const now = new Date();\n  const sortedEvents = [...mockEvents].sort((a, b) => {\n    const dateA = new Date(a.start_date);\n    const dateB = new Date(b.start_date);\n    const isPastA = dateA < now;\n    const isPastB = dateB < now;\n    \n    if (isPastA && !isPastB) return 1;\n    if (!isPastA && isPastB) return -1;\n    if (!isPastA && !isPastB) return dateA.getTime() - dateB.getTime(); // nearest first\n    return dateB.getTime() - dateA.getTime(); // most recent past first\n  });\n\n  const filteredEvents = sortedEvents.filter(event => {\n    if (filter === \'Todos\') return true;\n    if (filter === \'Pr\303\263ximos eventos\') return new Date(event.start_date) >= now;\n    if (filter === \'Eventos realizados\') return new Date(event.start_date) < now;\n    return event.category === filter;\n  });\n\n  const featuredEvent = sortedEvents.find(e => e.is_featured);\n\n  return (\n    <section id=\"eventos\" className=\"py-32 bg-[#101616] relative\">\n      <div className=\"max-w-7xl mx-auto px-6 md:px-12\">\n        <div className=\"mb-16\">\n          <h2 className=\"text-3xl md:text-5xl font-serif text-[#FFFDF8] mb-6\">Eventos e conhecimento em movimento.</h2>\n          <p className=\"text-[#F6F3EC]/70 text-lg max-w-2xl\">\n            Encontros, palestras e iniciativas que conectam conhecimento jur\303\255dico, inova\303\247\303\243o e impacto positivo.\n          </p>\n        </div>\n\n        {/* Filters */}\n        <div className=\"flex flex-wrap gap-3 mb-16\">\n          {categories.map(cat => (\n            <button\n              key={cat}\n              onClick={() => setFilter(cat)}\n              className={`px-5 py-2 rounded-full text-sm transition-all ${\n                filter === cat \n                  ? \'bg-[#D8CBB3] text-[#101616] font-medium\' \n                  : \'bg-transparent border border-[#D8CBB3]/30 text-[#F6F3EC]/80 hover:border-[#D8CBB3] hover:text-[#D8CBB3]\'\n              }`}\n            >\n              {cat}\n            </button>\n          ))}\n        </div>\n\n        {/* Featured Event */}\n        {featuredEvent && filter === \'Todos\' && (\n          <FeaturedEvent event={featuredEvent} />\n        )}\n\n        {/* Event Grid */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8\">\n          {filteredEvents.filter(e => e.id !== featuredEvent?.id || filter !== \'Todos\').map(event => (\n            <EventCard key={event.id} event={event} />\n          ))}\n        </div>\n      </div>\n    </section>\n  );\n};\n\nconst FeaturedEvent = ({ event }: { event: Event }) => {\n  const media = mockMedia.find(m => m.event_id === event.id && m.media_type === \'main\');\n  const isPast = new Date(event.start_date) < new Date();\n\n  return (\n    <div className=\"mb-16 bg-[#151f1f] border border-[#D8CBB3]/20 rounded-3xl overflow-hidden flex flex-col lg:flex-row group relative\">\n      {/* Background blur if horizontal */}\n      {media?.orientation === \'horizontal\' && (\n        <div \n          className=\"absolute inset-0 opacity-20 blur-3xl scale-110 pointer-events-none\"\n          style={{ backgroundImage: `url(${media.file_url})`, backgroundPosition: \'center\', backgroundSize: \'cover\' }}\n        />\n      )}\n      \n      <div className={`relative ${media?.orientation === \'vertical\' ? \'w-full lg:w-1/3 aspect-[4/5] lg:aspect-auto\' : \'w-full lg:w-2/3 h-64 lg:h-auto\'}`}>\n        {media ? (\n          <img \n            src={media.file_url} \n            alt={media.alt_text || event.title}\n            className=\"w-full h-full object-cover lg:object-contain bg-black/40\"\n          />\n        ) : (\n          <div className=\"w-full h-full bg-white/5\" />\n        )}\n      </div>\n\n      <div className=\"p-8 lg:p-12 flex flex-col justify-center flex-1 relative z-10 bg-gradient-to-r from-[#151f1f]/80 to-[#151f1f]\">\n        <div className=\"flex items-center gap-4 mb-6\">\n          <span className={`text-xs font-bold tracking-wider uppercase px-3 py-1 rounded-full ${isPast ? \'bg-white/10 text-[#F6F3EC]/70\' : \'bg-[#D8CBB3]/20 text-[#D8CBB3]\'}`}>\n            {isPast ? \'Evento Realizado\' : \'Pr\303\263ximo Evento\'}\n          </span>\n          <span className=\"text-[#F6F3EC]/50 text-sm\">{event.category}</span>\n        </div>\n        \n        <h3 className=\"text-3xl font-serif text-[#FFFDF8] mb-4 group-hover:text-[#D8CBB3] transition-colors\">{event.title}</h3>\n        <p className=\"text-[#F6F3EC]/70 mb-8 leading-relaxed max-w-xl\">{event.short_description}</p>\n        \n        <div className=\"flex flex-col sm:flex-row gap-6 mb-10 text-sm text-[#F6F3EC]/80\">\n          <div className=\"flex items-center gap-2\">\n            <Calendar className=\"w-4 h-4 text-[#D8CBB3]\" />\n            <span>{new Date(event.start_date).toLocaleDateString(\'pt-BR\')}</span>\n          </div>\n          <div className=\"flex items-center gap-2\">\n            <MapPin className=\"w-4 h-4 text-[#D8CBB3]\" />\n            <span>{event.location}</span>\n          </div>\n        </div>\n\n        <div className=\"flex flex-wrap gap-4 mt-auto\">\n          <a href={`/eventos/${event.slug}`} className=\"px-6 py-3 rounded-full bg-[#D8CBB3] text-[#101616] font-semibold hover:bg-[#FFFDF8] transition-colors\">\n            Conhe\303\247a o evento\n          </a>\n          {!isPast && event.registration_url && (\n            <a href={event.registration_url} target=\"_blank\" rel=\"noopener noreferrer\" className=\"px-6 py-3 rounded-full border border-[#D8CBB3]/50 text-[#D8CBB3] hover:bg-[#D8CBB3]/10 transition-colors\">\n              Inscreva-se\n            </a>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n\nconst EventCard = ({ event }: { event: Event }) => {\n  const media = mockMedia.find(m => m.event_id === event.id && m.media_type === \'main\');\n  const isPast = new Date(event.start_date) < new Date();\n  \n  // Calculate aspect ratio class based on orientation\n  let aspectClass = \"aspect-[4/5]\";\n  if (media?.orientation === \'horizontal\') aspectClass = \"aspect-[1.91/1]\";\n  if (media?.orientation === \'square\') aspectClass = \"aspect-square\";\n  if (media?.orientation === \'vertical\' && media?.aspect_ratio === \'9:16\') aspectClass = \"aspect-[9/16]\";\n\n  return (\n    <a href={`/eventos/${event.slug}`} className=\"group flex flex-col bg-[#151f1f] border border-[#D8CBB3]/15 rounded-2xl overflow-hidden hover:-translate-y-2 hover:shadow-[0_20px_40px_rgba(0,0,0,0.4)] transition-all duration-300\">\n      <div className={`relative w-full overflow-hidden bg-black/20 ${aspectClass}`}>\n        {/* Background blur for images that might not perfectly fit */}\n        {media && (\n          <div \n            className=\"absolute inset-0 opacity-30 blur-2xl scale-110 pointer-events-none\"\n            style={{ backgroundImage: `url(${media.file_url})`, backgroundPosition: \'center\', backgroundSize: \'cover\' }}\n          />\n        )}\n        {media ? (\n          <img \n            src={media.file_url} \n            alt={media.alt_text || event.title}\n            className=\"absolute inset-0 w-full h-full object-contain group-hover:scale-105 transition-transform duration-700 z-10\"\n          />\n        ) : (\n          <div className=\"absolute inset-0 bg-[#D8CBB3]/5 flex items-center justify-center\">\n            <span className=\"text-[#D8CBB3]/30 font-serif\">Sem imagem</span>\n          </div>\n        )}\n        \n        <div className=\"absolute top-4 left-4 z-20 flex gap-2\">\n          <span className={`text-[10px] font-bold tracking-wider uppercase px-2.5 py-1 rounded-full backdrop-blur-md ${isPast ? \'bg-black/50 text-[#F6F3EC]/90 border border-white/10\' : \'bg-[#D8CBB3]/90 text-[#101616]\'}`}>\n            {isPast ? \'Realizado\' : \'Pr\303\263ximo\'}\n          </span>\n        </div>\n      </div>\n\n      <div className=\"p-6 flex flex-col flex-1 relative z-10 bg-[#151f1f]\">\n        <span className=\"text-[#D8CBB3] text-xs font-medium tracking-wide uppercase mb-3\">{event.category}</span>\n        <h3 className=\"text-xl font-serif text-[#FFFDF8] mb-3 group-hover:text-[#D8CBB3] transition-colors line-clamp-2\">{event.title}</h3>\n        \n        <div className=\"space-y-2 mt-auto pt-6 border-t border-white/10 text-sm text-[#F6F3EC]/70\">\n          <div className=\"flex items-center gap-2\">\n            <Calendar className=\"w-4 h-4 text-[#D8CBB3]/70\" />\n            <span>{new Date(event.start_date).toLocaleDateString(\'pt-BR\')} {event.start_time && `\303\240s ${event.start_time}`}</span>\n          </div>\n          <div className=\"flex items-center gap-2\">\n            <MapPin className=\"w-4 h-4 text-[#D8CBB3]/70\" />\n            <span className=\"truncate\">{event.modality} \342\200\242 {event.location || \'Local a definir\'}</span>\n          </div>\n        </div>\n      </div>\n    </a>\n  );\n};\n"
    }
    diff {
      unified_diff {
        lines {
          text: "import React, { useState } from \'react\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
