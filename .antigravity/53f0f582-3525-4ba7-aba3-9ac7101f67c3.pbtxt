/}\n        <path d=\"M46 14 C33 38, 33 62, 46 86 L57 86 C44 62, 44 38, 57 14 Z\" />\n        {/* G Stem */}\n        <path d=\"M66 14 L78 14 L78 86 L66 86 Z\" />\n        {/* G Bottom Bar / Hook */}\n        <path d=\"M66 62 L90 62 L90 74 L66 74 Z\" />\n      </svg>\n\n      <div className=\"flex flex-col\">\n        <div className=\"flex items-center gap-2 leading-none\">\n          <span className=\"font-serif text-[#FFFDF8] font-semibold text-base md:text-lg tracking-wider\">\n            ALBUQUERQUE\n          </span>\n          <span className=\"font-serif text-[#FFFDF8] font-semibold text-base md:text-lg tracking-wider\">\n            GUERRA\n          </span>\n        </div>\n        <span className=\"text-[#D8CBB3] text-[10px] tracking-[0.3em] uppercase font-sans font-medium mt-1\">\n          advogados\n        </span>\n      </div>\n    </div>\n  );\n};\n"
