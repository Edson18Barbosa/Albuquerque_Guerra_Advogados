      target_content: "@import \"tailwindcss\";\n\n@theme {\n  --font-serif: \"Cormorant Garamond\", Georgia, serif;\n  --font-sans: \"Manrope\", sans-serif;\n  --color-ag-dark: #101616;\n  --color-ag-deep: #374544;\n  --color-ag-gray: #4D5D5D;\n  --color-ag-champagne: #D8CBB3;\n  --color-ag-light-beige: #EEE8DD;\n  --color-ag-offwhite: #F6F3EC;\n  --color-ag-warmwhite: #FFFDF8;\n}\n\n@layer base {\n  body {\n    font-family: var(--font-sans);\n    background-color: #101616;\n    color: #F6F3EC;\n  }\n  \n  h1, h2, h3, h4, h5, h6 {\n    font-family: var(--font-serif);\n  }\n}\n\n/* Custom smooth animations & glassmorphism */\n.glass-card {\n  background: rgba(55, 69, 68, 0.45);\n  backdrop-filter: blur(16px);\n  -webkit-backdrop-filter: blur(16px);\n  border: 1px solid rgba(216, 203, 179, 0.15);\n}\n\n.glass-card-hover {\n  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);\n}\n\n.glass-card-hover:hover {\n  background: rgba(55, 69, 68, 0.65);\n  border-color: rgba(216, 203, 179, 0.35);\n  transform: translateY(-4px);\n}\n\n/* Custom scrollbar */\n::-webkit-scrollbar {\n  width: 8px;\n}\n::-webkit-scrollbar-track {\n  background: #101616;\n}\n::-webkit-scrollbar-thumb {\n  background: #4D5D5D;\n  border-radius: 4px;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: #D8CBB3;\n}"
      replacement_content: "@import \"tailwindcss\";\n\n@theme {\n  --font-serif: \"Cormorant Garamond\", Georgia, serif;\n  --font-sans: \"Manrope\", sans-serif;\n  --color-ag-dark: #101616;\n  --color-ag-deep: #374544;\n  --color-ag-gray: #4D5D5D;\n  --color-ag-champagne: #D8CBB3;\n  --color-ag-light-beige: #EEE8DD;\n  --color-ag-offwhite: #F6F3EC;\n  --color-ag-warmwhite: #FFFDF8;\n}\n\n@layer base {\n  body {\n    font-family: var(--font-sans);\n    background-color: #101616;\n    color: #F6F3EC;\n  }\n  \n  h1, h2, h3, h4, h5, h6 {\n    font-family: var(--font-serif);\n  }\n}\n\n/* 3D and Animation Utilities */\n.perspective-1000 {\n  perspective: 1000px;\n}\n\n.transform-gpu {\n  transform: translateZ(0);\n}\n\n@keyframes spinSlow {\n  from { transform: rotate(0deg); }\n  to { transform: rotate(360deg); }\n}\n\n@keyframes reverseSpin {\n  from { transform: rotate(360deg); }\n  to { transform: rotate(0deg); }\n}\n\n@keyframes bounceSlow {\n  0%, 100% { transform: translateY(0); }\n  50% { transform: translateY(-8px); }\n}\n\n.animate-spin-slow {\n  animation: spinSlow 25s linear infinite;\n}\n\n.animate-reverse-spin {\n  animation: reverseSpin 30s linear infinite;\n}\n\n.animate-bounce-slow {\n  animation: bounceSlow 4s ease-in-out infinite;\n}\n\n/* Custom smooth animations & glassmorphism */\n.glass-card {\n  background: rgba(55, 69, 68, 0.45);\n  backdrop-filter: blur(16px);\n  -webkit-backdrop-filter: blur(16px);\n  border: 1px solid rgba(216, 203, 179, 0.15);\n}\n\n.glass-card-hover {\n  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);\n}\n\n.glass-card-hover:hover {\n  background: rgba(55, 69, 68, 0.65);\n  border-color: rgba(216, 203, 179, 0.35);\n  transform: translateY(-4px);\n}\n\n/* Custom scrollbar */\n::-webkit-scrollbar {\n  width: 8px;\n}\n::-webkit-scrollbar-track {\n  background: #101616;\n}\n::-webkit-scrollbar-thumb {\n  background: #4D5D5D;\n  border-radius: 4px;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: #D8CBB3;\n}\n"
