      replacement_content: "import React from \'react\';\n\ninterface LogoProps {\n  className?: string;\n  variant?: \'horizontal\' | \'vertical\';\n}\n\nexport const Logo: React.FC<LogoProps> = ({ className = \'\', variant = \'horizontal\' }) => {\n  if (variant === \'vertical\') {\n    return (\n      <div className={`flex flex-col items-center select-none bg-transparent ${className}`}>\n        {/* AG Icon Arches - Ultra Faithful & High Definition */}\n        <svg viewBox=\"0 0 100 100\" className=\"w-20 h-20 text-[#D8CBB3] mb-3 drop-shadow-md\" fill=\"currentColor\">\n          {/* Left Arch */}\n          <path d=\"M28 14 C15 38, 15 62, 28 86 L39 86 C26 62, 26 38, 39 14 Z\" />\n          {/* Right Arch */}\n          <path d=\"M46 14 C33 38, 33 62, 46 86 L57 86 C44 62, 44 38, 57 14 Z\" />\n          {/* G Stem */}\n          <path d=\"M66 14 L78 14 L78 86 L66 86 Z\" />\n          {/* G Bottom Bar / Hook */}\n          <path d=\"M66 62 L90 62 L90 74 L66 74 Z\" />\n        </svg>\n\n        <div className=\"text-center\">\n          <span className=\"font-serif text-[#FFFDF8] font-semibold text-lg tracking-[0.18em] block leading-tight\">\n            ALBUQUERQUE\n          </span>\n          <span className=\"font-serif text-[#FFFDF8] font-semibold text-lg tracking-[0.18em] block leading-tight mb-1.5\">\n            GUERRA\n          </span>\n          <span className=\"text-[#D8CBB3] text-[10px] tracking-[0.32em] uppercase font-sans font-medium block\">\n            advogados\n          </span>\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className={`flex items-center gap-4 select-none bg-transparent ${className}`}>\n      {/* AG Icon Arches - Ultra Faithful & High Definition */}\n      <svg viewBox=\"0 0 100 100\" className=\"w-12 h-12 text-[#D8CBB3] flex-shrink-0 drop-shadow-md\" fill=\"currentColor\">\n        {/* Left Arch */}\n        <path d=\"M28 14 C15 38, 15 62, 28 86 L39 86 C26 62, 26 38, 39 14 Z\" />\n        {/* Right Arch */}