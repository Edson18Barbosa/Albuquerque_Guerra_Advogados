    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { ArrowDown, Shield, Compass, ChevronRight } from \'lucide-react\';\n\nexport const Hero: React.FC = () => {\n  return (\n    <section className=\"relative min-h-screen flex items-center justify-center pt-28 pb-16 overflow-hidden bg-gradient-to-b from-[#101616] via-[#151f1f] to-[#101616]\">\n      {/* Background ambient lighting */}\n      <div className=\"absolute top-1/4 left-1/4 w-96 h-96 bg-[#374544]/30 rounded-full blur-3xl pointer-events-none animate-pulse\" />\n      <div className=\"absolute bottom-1/4 right-1/4 w-[30rem] h-[30rem] bg-[#D8CBB3]/5 rounded-full blur-3xl pointer-events-none\" />\n\n      {/* Grid overlay pattern */}\n      <div className=\"absolute inset-0 opacity-[0.03] bg-[radial-gradient(#D8CBB3_1px,transparent_1px)] [background-size:32px_32px] pointer-events-none\" />\n\n      <div className=\"max-w-7xl mx-auto px-6 md:px-12 w-full relative z-10\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center\">\n          \n          {/* Left Column: Text & Content */}\n          <div className=\"lg:col-span-7 flex flex-col items-start text-left\">\n            \n            {/* Top Tag & Number */}\n            <div className=\"flex items-center gap-4 mb-6\">\n              <span className=\"text-[#D8CBB3] font-serif text-sm tracking-widest border-b border-[#D8CBB3]/40 pb-1\">\n                01 / INSTITUCIONAL\n              </span>\n              <span className=\"inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-[#374544]/60 text-[#D8CBB3] border border-[#D8CBB3]/20\">\n                Recife \342\200\242 PE\n              </span>\n            </div>\n\n            {/* Subtitle / Support Text */}\n            <span className=\"text-[#D8CBB3] text-xs md:text-sm font-semibold tracking-[0.25em] uppercase mb-4\">\n              ADVOCACIA ESTRAT\303\211GICA E CONTEMPOR\303\202NEA\n            </span>\n\n            {/* Main Title */}\n            <h1 className=\"text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-serif font-light text-[#FFFDF8] tracking-tight leading-[1.1] mb-6\">\n              Seguran\303\247a jur\303\255dica que gera <br className=\"hidden sm:inline\" />\n              <span className=\"text-[#D8CBB3] italic font-normal\">impacto positivo.</span>\n            </h1>\n\n            {/* Description */}\n            <p className=\"text-[#F6F3EC]/80 text-base sm:text-lg md:text-xl font-light leading-relaxed max-w-2xl mb-10\">\n              Estrat\303\251gia, proximidade e conhecimento para proteger rela\303\247\303\265es, prevenir riscos e construir solu\303\247\303\265es juridicamente s\303\263lidas.\n            </p>\n\n            {/* CTA Buttons */}\n            <div className=\"flex flex-wrap items-center gap-4 w-full sm:w-auto\">\n              <a\n                href=\"#atuacao\"\n                className=\"px-7 py-4 rounded-xl bg-[#D8CBB3] text-[#101616] font-semibold text-sm tracking-wide hover:bg-[#FFFDF8] transition-all duration-300 shadow-xl flex items-center justify-center gap-3 group\"\n              >\n                <span>Conhe\303\247a nossa atua\303\247\303\243o</span>\n                <ChevronRight className=\"w-4 h-4 group-hover:translate-x-1 transition-transform\" />\n              </a>\n\n              <a\n                href=\"#valores\"\n                className=\"px-7 py-4 rounded-xl bg-[#374544]/50 hover:bg-[#374544] text-[#F6F3EC] font-medium text-sm tracking-wide transition-all duration-300 border border-[#D8CBB3]/30 flex items-center justify-center\"\n              >\n                Nossa ess\303\252ncia\n              </a>\n\n              <a\n                href=\"#contato\"\n                className=\"px-6 py-4 rounded-xl bg-transparent hover:bg-white/5 text-[#D8CBB3] font-medium text-sm tracking-wide transition-all duration-300 flex items-center justify-center\"\n              >\n                Fale com o escrit\303\263rio\n              </a>\n            </div>\n\n            {/* Bottom badges */}\n            <div className=\"grid grid-cols-2 sm:grid-cols-3 gap-6 mt-14 pt-10 border-t border-white/15 w-full\">\n              <div className=\"flex flex-col\">\n                <span className=\"text-[#D8CBB3] font-serif text-2xl md:text-3xl font-bold\">Contencioso</span>\n                <span className=\"text-[#F6F3EC]/70 text-xs mt-1\">Estrat\303\251gia e rigor processual</span>\n              </div>\n              <div className=\"flex flex-col\">\n                <span className=\"text-[#D8CBB3] font-serif text-2xl md:text-3xl font-bold\">Consultivo</span>\n                <span className=\"text-[#F6F3EC]/70 text-xs mt-1\">Preven\303\247\303\243o e seguran\303\247a</span>\n              </div>\n              <div className=\"hidden sm:flex flex-col\">\n                <span className=\"text-[#D8CBB3] font-serif text-2xl md:text-3xl font-bold\">\303\211tica</span>\n                <span className=\"text-[#F6F3EC]/70 text-xs mt-1\">Transpar\303\252ncia constante</span>\n              </div>\n            </div>\n\n          </div>\n\n          {/* Right Column: Cinematic Asymmetric Visual & 3D Monogram Showcase */}\n          <div className=\"lg:col-span-5 relative flex items-center justify-center\">\n            \n            {/* Floating 3D Monogram Badge */}\n            <div className=\"absolute -top-6 -left-6 z-20 w-24 h-24 rounded-2xl bg-[#101616]/90 border border-[#D8CBB3]/40 p-3 shadow-2xl backdrop-blur-md hidden sm:flex flex-col items-center justify-center animate-bounce-slow\">\n              <div className=\"w-10 h-10 rounded-full bg-gradient-to-tr from-[#D8CBB3] to-[#374544] flex items-center justify-center mb-1 shadow-inner\">\n                <span className=\"font-serif text-[#101616] font-extrabold text-sm tracking-tighter\">AG</span>\n              </div>\n              <span className=\"text-[9px] uppercase tracking-widest text-[#D8CBB3] font-semibold\">Advogados</span>\n            </div>\n\n            {/* Main Asymmetric Image Container */}\n            <div className=\"relative w-full rounded-2xl overflow-hidden border border-[#D8CBB3]/30 shadow-2xl group\">\n              <div className=\"absolute inset-0 bg-gradient-to-t from-[#101616] via-transparent to-transparent z-10 opacity-60\" />\n              \n              {/* Professional team in office photo */}\n              <img\n                src=\"https://images.unsplash.com/photo-1556761175-5973dc0f32e7?auto=format&fit=crop&w=1200&q=80\"\n                alt=\"Albuquerque Guerra Advogados - Escrit\303\263rio\"\n                className=\"w-full h-[450px] md:h-[540px] object-cover object-center group-hover:scale-105 transition-transform duration-700 filter saturate-[0.85] contrast-[1.05]\"\n              />\n\n              {/* Overlay card */}\n              <div className=\"absolute bottom-6 left-6 right-6 z-20 p-5 rounded-xl bg-[#101616]/85 backdrop-blur-md border border-[#D8CBB3]/20 flex items-center justify-between\">\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"w-10 h-10 rounded-lg bg-[#374544] flex items-center justify-center text-[#D8CBB3]\">\n                    <Shield className=\"w-5 h-5\" />\n                  </div>\n                  <div>\n                    <h4 className=\"text-sm font-serif text-[#FFFDF8] font-semibold\">Atua\303\247\303\243o Especializada</h4>\n                    <p className=\"text-xs text-[#F6F3EC]/70\">Recife e Tribunais Superiores</p>\n                  </div>\n                </div>\n                <a\n                  href=\"#escritorio\"\n                  className=\"w-9 h-9 rounded-full bg-[#D8CBB3]/20 hover:bg-[#D8CBB3] text-[#D8CBB3] hover:text-[#101616] transition-all flex items-center justify-center\"\n                  aria-label=\"Saiba mais\"\n                >\n                  <ChevronRight className=\"w-4 h-4\" />\n                </a>\n              </div>\n            </div>\n\n            {/* Decorative orbit ring graphic */}\n            <div className=\"absolute -bottom-8 -right-8 w-48 h-48 border border-[#D8CBB3]/20 rounded-full pointer-events-none -z-10 animate-spin-slow\" />\n\n          </div>\n\n        </div>\n\n        {/* Scroll indicator */}\n        <div className=\"absolute bottom-4 left-1/2 -translate-x-1/2 hidden md:flex flex-col items-center gap-2 opacity-70 hover:opacity-100 transition-opacity\">\n          <span className=\"text-[10px] uppercase tracking-[0.3em] text-[#D8CBB3]\">Role para explorar</span>\n          <ArrowDown className=\"w-4 h-4 text-[#D8CBB3] animate-bounce\" />\n        </div>\n\n      </div>\n    </section>\n  );\n};\n"
    }
