    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { ArrowUp, Phone, Mail, MapPin } from \'lucide-react\';\nimport { Logo } from \'./Logo\';\n\nexport const Footer: React.FC = () => {\n  const scrollToTop = () => {\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\n  };\n\n  return (\n    <footer className=\"bg-[#0a0e0e] text-[#F6F3EC] pt-20 pb-12 border-t border-[#D8CBB3]/20 relative\">\n      <div className=\"max-w-7xl mx-auto px-6 md:px-12\">\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12 pb-16 border-b border-white/10\">\n          \n          {/* Col 1: Brand */}\n          <div className=\"lg:col-span-4 space-y-6\">\n            <Logo />\n\n            <p className=\"text-[#F6F3EC]/70 text-sm font-light leading-relaxed\">\n              Albuquerque Guerra Advogados \342\200\224 estrat\303\251gia, dilig\303\252ncia, transpar\303\252ncia e conhecimento a servi\303\247o de rela\303\247\303\265es juridicamente mais seguras.\n            </p>\n\n            <div className=\"pt-2\">\n              <span className=\"text-xs text-[#D8CBB3] font-semibold uppercase tracking-wider block mb-1\">\n                Recife \342\200\242 Pernambuco\n              </span>\n              <p className=\"text-xs text-[#F6F3EC]/60\">\n                Atua\303\247\303\243o em tribunais estaduais, federais e superiores.\n              </p>\n            </div>\n          </div>\n\n          {/* Col 2: Quick Links */}\n          <div className=\"lg:col-span-3 space-y-4\">\n            <h4 className=\"font-serif text-lg text-[#FFFDF8] tracking-wide\">Navega\303\247\303\243o</h4>\n            <ul className=\"space-y-2.5 text-sm font-light\">\n              <li>\n                <a href=\"#escritorio\" className=\"text-[#F6F3EC]/70 hover:text-[#D8CBB3] transition-colors\">\n                  O Escrit\303\263rio\n                </a>\n              </li>\n              <li>\n                <a href=\"#atuacao\" className=\"text-[#F6F3EC]/70 hover:text-[#D8CBB3] transition-colors\">\n                  \303\201reas de Atua\303\247\303\243o\n                </a>\n              </li>\n              <li>\n                <a href=\"#valores\" className=\"text-[#F6F3EC]/70 hover:text-[#D8CBB3] transition-colors\">\n                  Tr\303\255ade de Valores\n                </a>\n              </li>\n              <li>\n                <a href=\"#missao-visao\" className=\"text-[#F6F3EC]/70 hover:text-[#D8CBB3] transition-colors\">\n                  Miss\303\243o e Vis\303\243o\n                </a>\n              </li>\n              <li>\n                <a href=\"#equipe\" className=\"text-[#F6F3EC]/70 hover:text-[#D8CBB3] transition-colors\">\n                  Equipe\n                </a>\n              </li>\n              <li>\n                <a href=\"#contato\" className=\"text-[#F6F3EC]/70 hover:text-[#D8CBB3] transition-colors\">\n                  Contato\n                </a>\n              </li>\n            </ul>\n          </div>\n\n          {/* Col 3: Practice Areas */}\n          <div className=\"lg:col-span-2 space-y-4\">\n            <h4 className=\"font-serif text-lg text-[#FFFDF8] tracking-wide\">\303\201reas</h4>\n            <ul className=\"space-y-2.5 text-sm font-light\">\n              <li className=\"text-[#F6F3EC]/70\">Trabalhista e Previdenci\303\241rio</li>\n              <li className=\"text-[#F6F3EC]/70\">Tribut\303\241rio</li>\n              <li className=\"text-[#F6F3EC]/70\">Civil e Imobili\303\241rio</li>\n              <li className=\"text-[#F6F3EC]/70\">Consumidor</li>\n              <li className=\"text-[#F6F3EC]/70\">Terceiro Setor</li>\n            </ul>\n          </div>\n\n          {/* Col 4: Contact info */}\n          <div className=\"lg:col-span-3 space-y-4\">\n            <h4 className=\"font-serif text-lg text-[#FFFDF8] tracking-wide\">Contato</h4>\n            <div className=\"space-y-3 text-sm font-light text-[#F6F3EC]/70\">\n              <p className=\"flex items-start gap-2\">\n                <MapPin className=\"w-4 h-4 text-[#D8CBB3] flex-shrink-0 mt-1\" />\n                <span>Rua Arn\303\263bio Marques, 253, Sl 1703, Recife - PE</span>\n              </p>\n              <p className=\"flex items-center gap-2\">\n                <Phone className=\"w-4 h-4 text-[#D8CBB3] flex-shrink-0\" />\n                <span>(81) 3071-8988</span>\n              </p>\n              <p className=\"flex items-center gap-2\">\n                <Mail className=\"w-4 h-4 text-[#D8CBB3] flex-shrink-0\" />\n                <span>contato@albuquerqueguerra.adv.br</span>\n              </p>\n            </div>\n          </div>\n\n        </div>\n\n        {/* Bottom Bar */}\n        <div className=\"pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#F6F3EC]/50\">\n          <p>\n            \302\251 {new Date().getFullYear()} Albuquerque Guerra Advogados. Todos os direitos reservados.\n          </p>\n\n          <div className=\"flex items-center gap-6\">\n            <a href=\"#\" className=\"hover:text-[#D8CBB3] transition-colors\">\n              Pol\303\255tica de Privacidade\n            </a>\n            <button\n              onClick={scrollToTop}\n              className=\"p-2 rounded-lg bg-[#151f1f] border border-[#D8CBB3]/30 text-[#D8CBB3] hover:bg-[#D8CBB3] hover:text-[#101616] transition-all flex items-center gap-2\"\n              aria-label=\"Voltar ao topo\"\n            >\n              <span>Topo</span>\n              <ArrowUp className=\"w-4 h-4\" />\n            </button>\n          </div>\n        </div>\n\n      </div>\n    </footer>\n  );\n};\n"
    }
