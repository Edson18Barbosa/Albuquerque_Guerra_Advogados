  file_change {
    absolute_path_uri: "file:///src/components/Logo.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React from \'react\';\n\ninterface LogoProps {\n  className?: string;\n  variant?: \'horizontal\' | \'vertical\';\n}\n\nexport const Logo: React.FC<LogoProps> = ({ className = \'\', variant = \'horizontal\' }) => {\n  if (variant === \'vertical\') {\n    return (\n      <div className={`flex flex-col items-center select-none bg-transparent ${className}`}>\n        {/* AG Monogram - Exact Vector Match */}\n        <svg viewBox=\"0 0 110 100\" className=\"w-24 h-20 text-[#D8CBB3] mb-3 drop-shadow-xl\" fill=\"currentColor\">\n          {/* Left Arch */}\n          <path d=\"M26 8 C12 35, 12 65, 26 92 L40 92 C26 65, 26 35, 40 8 Z\" />\n          {/* Right Arch / Curve */}\n          <path d=\"M46 8 C32 35, 32 65, 46 92 L60 92 C46 65, 46 35, 60 8 Z\" />\n          {/* G Vertical Stem */}\n          <rect x=\"68\" y=\"8\" width=\"12\" height=\"84\" rx=\"1\" />\n          {/* G Horizontal Bar */}\n          <rect x=\"68\" y=\"58\" width=\"24\" height=\"12\" rx=\"1\" />\n        </svg>\n\n        <div className=\"text-center\">\n          <span className=\"font-serif text-[#FFFDF8] font-semibold text-lg tracking-[0.2em] block leading-tight\">\n            ALBUQUERQUE\n          </span>\n          <span className=\"font-serif text-[#FFFDF8] font-semibold text-lg tracking-[0.2em] block leading-tight mb-1.5\">\n            GUERRA\n          </span>\n          <span className=\"text-[#D8CBB3] text-[10px] tracking-[0.35em] uppercase font-sans font-medium block\">\n            advogados\n          </span>\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className={`flex items-center gap-4 select-none bg-transparent ${className}`}>\n      {/* AG Monogram - Exact Vector Match */}\n      <svg viewBox=\"0 0 110 100\" className=\"w-12 h-10 text-[#D8CBB3] flex-shrink-0 drop-shadow-md\" fill=\"currentColor\">\n        {/* Left Arch */}\n        <path d=\"M26 8 C12 35, 12 65, 26 92 L40 92 C26 65, 26 35, 40 8 Z\" />\n        {/* Right Arch / Curve */}\n        <path d=\"M46 8 C32 35, 32 65, 46 92 L60 92 C46 65, 46 35, 60 8 Z\" />\n        {/* G Vertical Stem */}\n        <rect x=\"68\" y=\"8\" width=\"12\" height=\"84\" rx=\"1\" />\n        {/* G Horizontal Bar */}\n        <rect x=\"68\" y=\"58\" width=\"24\" height=\"12\" rx=\"1\" />\n      </svg>\n\n      <div className=\"flex flex-col\">\n        <div className=\"flex items-center gap-2 leading-none\">\n          <span className=\"font-serif text-[#FFFDF8] font-semibold text-base md:text-lg tracking-[0.18em]\">\n            ALBUQUERQUE\n          </span>\n          <span className=\"font-serif text-[#FFFDF8] font-semibold text-base md:text-lg tracking-[0.18em]\">\n            GUERRA\n          </span>\n        </div>\n        <span className=\"text-[#D8CBB3] text-[10px] tracking-[0.32em] uppercase font-sans font-medium mt-1\">\n          advogados\n        </span>\n      </div>\n    </div>\n  );\n};"
