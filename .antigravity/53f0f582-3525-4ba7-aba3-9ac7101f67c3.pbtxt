    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { Plus, Search, Filter, MoreVertical, Edit, Copy, Eye, Trash2 } from \'lucide-react\';\nimport { mockEvents } from \'../../data/mockEvents\';\n\nexport const AdminEvents: React.FC = () => {\n  return (\n    <div className=\"space-y-8 animate-fadeIn\">\n      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4\">\n        <div>\n          <h1 className=\"text-3xl font-serif text-[#FFFDF8] mb-2\">Gerenciar eventos</h1>\n          <p className=\"text-[#F6F3EC]/70\">Cadastre, edite e acompanhe os eventos do escrit\303\263rio.</p>\n        </div>\n        <button className=\"px-6 py-3 bg-[#D8CBB3] text-[#101616] font-semibold rounded-xl hover:bg-[#FFFDF8] transition-colors flex items-center gap-2 shadow-lg shrink-0\">\n          <Plus className=\"w-5 h-5\" />\n          Adicionar evento\n        </button>\n      </div>\n\n      {/* Stats */}\n      <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4\">\n        <StatCard title=\"Total\" value=\"3\" />\n        <StatCard title=\"Pr\303\263ximos\" value=\"1\" highlight />\n        <StatCard title=\"Realizados\" value=\"2\" />\n        <StatCard title=\"Rascunhos\" value=\"0\" />\n      </div>\n\n      {/* Filters and Search */}\n      <div className=\"flex flex-col md:flex-row gap-4\">\n        <div className=\"relative flex-1\">\n          <Search className=\"absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-[#F6F3EC]/40\" />\n          <input \n            type=\"text\" \n            placeholder=\"Buscar por nome do evento...\" \n            className=\"w-full bg-[#151f1f] border border-white/10 rounded-xl py-3 pl-12 pr-4 text-[#F6F3EC] focus:outline-none focus:border-[#D8CBB3]/50 transition-colors\"\n          />\n        </div>\n        <div className=\"flex gap-4\">\n          <select className=\"bg-[#151f1f] border border-white/10 rounded-xl py-3 px-4 text-[#F6F3EC] focus:outline-none focus:border-[#D8CBB3]/50 transition-colors appearance-none min-w-[150px]\">\n            <option>Todas as categorias</option>\n            <option>Palestras</option>\n            <option>Workshops</option>\n            <option>Congressos</option>\n          </select>\n          <select className=\"bg-[#151f1f] border border-white/10 rounded-xl py-3 px-4 text-[#F6F3EC] focus:outline-none focus:border-[#D8CBB3]/50 transition-colors appearance-none min-w-[150px]\">\n            <option>Todos os status</option>\n            <option>Publicado</option>\n            <option>Rascunho</option>\n          </select>\n        </div>\n      </div>\n\n      {/* Table */}\n      <div className=\"bg-[#151f1f] border border-white/10 rounded-2xl overflow-hidden\">\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left border-collapse\">\n            <thead>\n              <tr className=\"border-b border-white/10 bg-white/5\">\n                <th className=\"p-4 text-sm font-medium text-[#F6F3EC]/70\">Evento</th>\n                <th className=\"p-4 text-sm font-medium text-[#F6F3EC]/70\">Data</th>\n                <th className=\"p-4 text-sm font-medium text-[#F6F3EC]/70\">Categoria</th>\n                <th className=\"p-4 text-sm font-medium text-[#F6F3EC]/70\">Status</th>\n                <th className=\"p-4 text-sm font-medium text-[#F6F3EC]/70\">A\303\247\303\265es</th>\n              </tr>\n            </thead>\n            <tbody>\n              {mockEvents.map(event => (\n                <tr key={event.id} className=\"border-b border-white/5 hover:bg-white/5 transition-colors group\">\n                  <td className=\"p-4\">\n                    <div className=\"flex items-center gap-4\">\n                      <div className=\"w-12 h-12 bg-black/40 rounded-lg overflow-hidden flex-shrink-0\">\n                        <div className=\"w-full h-full bg-[#D8CBB3]/10\" />\n                      </div>\n                      <div>\n                        <p className=\"font-medium text-[#FFFDF8] line-clamp-1\">{event.title}</p>\n                        <div className=\"flex items-center gap-2 mt-1\">\n                          {event.is_featured && <span className=\"text-[10px] uppercase bg-[#D8CBB3]/20 text-[#D8CBB3] px-2 py-0.5 rounded-sm\">Destaque</span>}\n                          <span className=\"text-xs text-[#F6F3EC]/50\">{event.modality}</span>\n                        </div>\n                      </div>\n                    </div>\n                  </td>\n                  <td className=\"p-4 text-sm text-[#F6F3EC]/80 whitespace-nowrap\">\n                    {new Date(event.start_date).toLocaleDateString(\'pt-BR\')}\n                  </td>\n                  <td className=\"p-4 text-sm text-[#F6F3EC]/80 whitespace-nowrap\">\n                    {event.category}\n                  </td>\n                  <td className=\"p-4 whitespace-nowrap\">\n                    <span className={`text-xs px-2.5 py-1 rounded-full ${event.status === \'Publicado\' ? \'bg-green-500/10 text-green-400\' : \'bg-yellow-500/10 text-yellow-400\'}`}>\n                      {event.status}\n                    </span>\n                  </td>\n                  <td className=\"p-4\">\n                    <div className=\"flex items-center gap-2\">\n                      <button className=\"p-2 text-[#F6F3EC]/50 hover:text-[#D8CBB3] hover:bg-[#D8CBB3]/10 rounded-lg transition-colors\" title=\"Visualizar\">\n                        <Eye className=\"w-4 h-4\" />\n                      </button>\n                      <button className=\"p-2 text-[#F6F3EC]/50 hover:text-[#D8CBB3] hover:bg-[#D8CBB3]/10 rounded-lg transition-colors\" title=\"Editar\">\n                        <Edit className=\"w-4 h-4\" />\n                      </button>\n                      <button className=\"p-2 text-[#F6F3EC]/50 hover:text-red-400 hover:bg-red-400/10 rounded-lg transition-colors\" title=\"Excluir\">\n                        <Trash2 className=\"w-4 h-4\" />\n                      </button>\n                    </div>\n                  </td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nconst StatCard = ({ title, value, highlight = false }: { title: string, value: string, highlight?: boolean }) => (\n  <div className={`p-4 rounded-xl border ${highlight ? \'bg-[#D8CBB3]/10 border-[#D8CBB3]/30\' : \'bg-[#151f1f] border-white/10\'}`}>\n    <p className=\"text-sm text-[#F6F3EC]/70 mb-1\">{title}</p>\n    <p className={`text-2xl font-semibold ${highlight ? \'text-[#D8CBB3]\' : \'text-[#FFFDF8]\'}`}>{value}</p>\n  </div>\n);"
    }
