      replacement_content: "import React from \'react\';\nimport { Search, FileText, CheckSquare, TrendingUp } from \'lucide-react\';\n\nexport const Workflow: React.FC = () => {\n  const steps = [\n    {\n      number: \'01\',\n      title: \'Compreender\',\n      description: \'Analisamos o contexto, as necessidades, os riscos e os objetivos envolvidos.\',\n      icon: Search,\n    },\n    {\n      number: \'02\',\n      title: \'Planejar\',\n      description: \'Constru\303\255mos uma estrat\303\251gia jur\303\255dica clara, respons\303\241vel e adequada \303\240 realidade apresentada.\',\n      icon: FileText,\n    },\n    {\n      number: \'03\',\n      title: \'Atuar\',\n      description: \'Aplicamos o conhecimento t\303\251cnico de forma diligente, estrat\303\251gica e organizada.\',\n      icon: CheckSquare,\n    },\n    {\n      number: \'04\',\n      title: \'Acompanhar\',\n      description: \'Monitoramos os pr\303\263ximos passos e mantemos o cliente informado durante toda a atua\303\247\303\243o.\',\n      icon: TrendingUp,\n    },\n  ];\n\n  return (\n    <section className=\"py-24 md:py-32 bg-[#151f1f] relative overflow-hidden\">\n      <div className=\"absolute top-0 right-1/3 w-80 h-80 bg-[#374544]/20 rounded-full blur-3xl pointer-events-none\" />\n\n      <div className=\"max-w-7xl mx-auto px-6 md:px-12 relative z-10\">\n        \n        {/* Section Header */}\n        <div className=\"text-center max-w-3xl mx-auto mb-20\">\n          <span className=\"text-[#D8CBB3] font-serif text-sm tracking-widest block mb-3\">\n            06 / M\303\211TODO DE TRABALHO\n          </span>\n          <h2 className=\"text-3xl sm:text-4xl md:text-5xl font-serif text-[#FFFDF8] font-light mb-6\">\n            Nossa forma de <span className=\"text-[#D8CBB3] italic\">atua\303\247\303\243o.</span>\n          </h2>\n          <p className=\"text-[#F6F3EC]/80 text-base md:text-lg font-light\">\n            Um processo estruturado em quatro etapas para garantir seguran\303\247a, previsibilidade e excel\303\252ncia em cada caso.\n          </p>\n        </div>\n\n        {/* Timeline Grid */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 relative\">\n          \n          {steps.map((step, index) => {\n            const Icon = step.icon;\n            return (\n              <div\n                key={step.number}\n                className=\"p-8 rounded-2xl bg-[#101616]/80 border border-[#D8CBB3]/20 hover:border-[#D8CBB3]/60 transition-all duration-300 group flex flex-col justify-between shadow-xl relative\"\n              >\n                {/* Step number badge */}\n                <div className=\"absolute -top-4 right-6 w-10 h-10 rounded-full bg-[#374544] border border-[#D8CBB3]/40 flex items-center justify-center font-serif text-[#D8CBB3] text-sm font-bold shadow-md\">\n                  {step.number}\n                </div>\n\n                <div>\n                  <div className=\"w-12 h-12 rounded-xl bg-[#374544]/50 border border-[#D8CBB3]/20 flex items-center justify-center text-[#D8CBB3] mb-6 group-hover:bg-[#D8CBB3] group-hover:text-[#101616] transition-colors\">\n                    <Icon className=\"w-6 h-6\" />\n                  </div>\n\n                  <h3 className=\"text-2xl font-serif text-[#FFFDF8] mb-3 group-hover:text-[#D8CBB3] transition-colors\">\n                    {step.title}\n                  </h3>\n\n                  <p className=\"text-[#F6F3EC]/70 text-sm font-light leading-relaxed\">\n                    {step.description}\n                  </p>\n                </div>\n\n                <div className=\"mt-8 pt-4 border-t border-white/5 flex items-center justify-between text-xs text-[#D8CBB3]/60\">\n                  <span>Etapa {index + 1} de 4</span>\n                  <span>Albuquerque Guerra</span>\n                </div>\n              </div>\n            );\n          })}\n\n        </div>\n\n      </div>\n    </section>\n  );\n};\n"
