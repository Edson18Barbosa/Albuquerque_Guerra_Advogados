      replacement_content: "import React from \'react\';\n\ninterface LogoProps {\n  className?: string;\n  variant?: \'horizontal\' | \'vertical\';\n}\n\nexport const Logo: React.FC<LogoProps> = ({ className = \'\', variant = \'horizontal\' }) => {\n  if (variant === \'vertical\') {\n    return (\n      <div className={`flex flex-col items-center select-none bg-transparent ${className}`}>\n        {/* AG Monogram - Exact PDF Vector Match */}\n        <svg viewBox=\"0 0 120 100\" className=\"w-24 h-20 text-[#D8CBB3] mb-3 drop-shadow-xl\" fill=\"currentColor\">\n          {/* First Elegant Arch (A/G left curve) */}\n          <path d=\"M30 10 C15 35, 15 65, 30 90 L44 90 C29 65, 29 35, 44 10 Z\" />\n          {/* Second Intertwined Arch (G main curve) */}\n          <path d=\"M52 10 C37 35, 37 65, 52 90 L66 90 C51 65, 51 35, 66 10 Z\" />\n          {/* G Vertical Stem */}\n          <rect x=\"74\" y=\"10\" width=\"14\" height=\"80\" rx=\"1\" />\n          {/* G Horizontal Bar */}\n          <rect x=\"74\" y=\"58\" width=\"28\" height=\"14\" rx=\"1\" />\n        </svg>\n\n        <div className=\"text-center\">\n          <span className=\"font-serif text-[#FFFDF8] font-semibold text-lg tracking-[0.2em] block leading-tight\">\n            ALBUQUERQUE\n          </span>\n          <span className=\"font-serif text-[#FFFDF8] font-semibold text-lg tracking-[0.2em] block leading-tight mb-1.5\">\n            GUERRA\n          </span>\n          <span className=\"text-[#D8CBB3] text-[10px] tracking-[0.35em] uppercase font-sans font-medium block\">\n            advogados\n          </span>\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className={`flex items-center gap-4 select-none bg-transparent ${className}`}>\n      {/* AG Monogram - Exact PDF Vector Match */}\n      <svg viewBox=\"0 0 120 100\" className=\"w-12 h-10 text-[#D8CBB3] flex-shrink-0 drop-shadow-md\" fill=\"currentColor\">\n        {/* First Elegant Arch */}\n        <path d=\"M30 10 C15 35