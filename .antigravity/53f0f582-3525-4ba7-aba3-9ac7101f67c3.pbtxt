    generator_model: MODEL_GOOGLE_GEMINI_INTERNAL_BYOM
    execution_id: "53f0f582-3525-4ba7-aba3-9ac7101f67c3"
    source_trajectory_step_info {
      trajectory_id: "53f0f582-3525-4ba7-aba3-9ac7101f67c3"
