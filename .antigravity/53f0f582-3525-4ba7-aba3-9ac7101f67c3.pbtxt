    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Upload, X, Image as ImageIcon, Search, Filter, MoreVertical, Trash2 } from \'lucide-react\';\n\nexport const AdminMedia: React.FC = () => {\n  const [searchTerm, setSearchTerm] = useState(\'\');\n  \n  // Mock media items based on what we\'re using in the site\n  const [mediaItems, setMediaItems] = useState([\n    { id: 1, url: \'https://images.unsplash.com/photo-1589829085413-56de8ae18c73?auto=format&fit=crop&w=1000&q=80\', name: \'Escrit\303\263rio Fachada\', size: \'1.2 MB\', date: \'10 Out 2023\' },\n    { id: 2, url: \'https://images.unsplash.com/photo-1505664159854-232658a3c82b?auto=format&fit=crop&w=800&q=80\', name: \'Sala de Reuni\303\265es\', size: \'2.4 MB\', date: \'12 Out 2023\' },\n    { id: 3, url: \'https://images.unsplash.com/photo-1450101499163-c8848c66ca85?auto=format&fit=crop&w=800&q=80\', name: \'Documentos\', size: \'850 KB\', date: \'15 Out 2023\' },\n    { id: 4, url: \'https://images.unsplash.com/photo-1589391886645-d51941baf7fb?auto=format&fit=crop&w=800&q=80\', name: \'Tribunal\', size: \'3.1 MB\', date: \'20 Out 2023\' },\n    { id: 5, url: \'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=800&q=80\', name: \'Renata Albuquerque\', size: \'1.5 MB\', date: \'01 Nov 2023\' },\n    { id: 6, url: \'https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&w=800&q=80\', name: \'Jo\303\243o Guerra\', size: \'1.6 MB\', date: \'01 Nov 2023\' },\n  ]);\n\n  const [isUploading, setIsUploading] = useState(false);\n\n  const filteredItems = mediaItems.filter(item => \n    item.name.toLowerCase().includes(searchTerm.toLowerCase())\n  );\n\n  const handleDelete = (id: number) => {\n    if (confirm(\'Tem certeza que deseja excluir esta imagem?\')) {\n      setMediaItems(mediaItems.filter(item => item.id !== id));\n    }\n  };\n\n  return (\n    <div className=\"space-y-6 animate-fadeIn\">\n      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4\">\n        <div>\n          <h1 className=\"text-3xl font-serif text-[#FFFDF8] mb-2\">Biblioteca de M\303\255dia</h1>\n          <p className=\"text-[#F6F3EC]/70\">Gerencie as imagens e arquivos utilizados no site.</p>\n        </div>\n        <button \n          onClick={() => setIsUploading(true)}\n          className=\"flex items-center gap-2 px-5 py-2.5 bg-[#D8CBB3] text-[#101616] font-semibold rounded-xl hover:bg-[#FFFDF8] transition-colors\"\n        >\n          <Upload className=\"w-5 h-5\" />\n          Fazer Upload\n        </button>\n      </div>\n\n      {isUploading && (\n        <div className=\"p-8 border border-dashed border-[#D8CBB3]/40 rounded-2xl bg-[#D8CBB3]/5 flex flex-col items-center justify-center text-center\">\n          <div className=\"w-16 h-16 rounded-full bg-[#D8CBB3]/10 flex items-center justify-center text-[#D8CBB3] mb-4\">\n            <Upload className=\"w-8 h-8\" />\n          </div>\n          <h3 className=\"text-xl font-serif text-[#FFFDF8] mb-2\">Arraste seus arquivos para c\303\241</h3>\n          <p className=\"text-[#F6F3EC]/70 mb-6\">ou clique para procurar no seu computador (PNG, JPG, WEBP)</p>\n          <div className=\"flex gap-4\">\n            <button className=\"px-6 py-2 bg-white/10 text-white rounded-lg hover:bg-white/20 transition-colors\">\n              Selecionar arquivos\n            </button>\n            <button \n              onClick={() => setIsUploading(false)}\n              className=\"px-6 py-2 bg-transparent text-[#F6F3EC]/70 hover:text-white transition-colors\"\n            >\n              Cancelar\n            </button>\n          </div>\n        </div>\n      )}\n\n      <div className=\"bg-[#151f1f] border border-white/10 rounded-2xl overflow-hidden flex flex-col\">\n        {/* Toolbar */}\n        <div className=\"p-4 border-b border-white/10 flex flex-col sm:flex-row justify-between items-center gap-4\">\n          <div className=\"relative w-full sm:max-w-md\">\n            <Search className=\"absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-[#F6F3EC]/40\" />\n            <input \n              type=\"text\" \n              placeholder=\"Buscar m\303\255dia...\"\n              value={searchTerm}\n              onChange={(e) => setSearchTerm(e.target.value)}\n              className=\"w-full bg-[#101616] border border-white/10 text-[#F6F3EC] rounded-xl pl-10 pr-4 py-2 focus:outline-none focus:border-[#D8CBB3]/50 transition-colors\"\n            />\n          </div>\n          <button className=\"flex items-center gap-2 px-4 py-2 bg-[#101616] border border-white/10 text-[#F6F3EC]/70 rounded-xl hover:text-white transition-colors\">\n            <Filter className=\"w-5 h-5\" />\n            Filtrar\n          </button>\n        </div>\n\n        {/* Grid */}\n        <div className=\"p-6\">\n          {filteredItems.length > 0 ? (\n            <div className=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-6\">\n              {filteredItems.map(item => (\n                <div key={item.id} className=\"group relative rounded-xl border border-white/10 overflow-hidden bg-[#101616]\">\n                  <div className=\"aspect-square overflow-hidden bg-black/50\">\n                    <img \n                      src={item.url} \n                      alt={item.name} \n                      className=\"w-full h-full object-cover transition-transform duration-500 group-hover:scale-110\"\n                    />\n                  </div>\n                  <div className=\"p-3\">\n                    <p className=\"text-sm font-medium text-[#FFFDF8] truncate\" title={item.name}>{item.name}</p>\n                    <div className=\"flex items-center justify-between mt-1 text-xs text-[#F6F3EC]/50\">\n                      <span>{item.size}</span>\n                      <span>{item.date}</span>\n                    </div>\n                  </div>\n                  \n                  {/* Actions overlay */}\n                  <div className=\"absolute top-2 right-2 opacity-0 group-hover:opacity-100 transition-opacity\">\n                    <button \n                      onClick={() => handleDelete(item.id)}\n                      className=\"p-1.5 bg-red-500/80 text-white rounded-lg hover:bg-red-500 transition-colors backdrop-blur-sm\"\n                      title=\"Excluir\"\n                    >\n                      <Trash2 className=\"w-4 h-4\" />\n                    </button>\n                  </div>\n                </div>\n              ))}\n            </div>\n          ) : (\n            <div className=\"py-12 text-center\">\n              <ImageIcon className=\"w-16 h-16 text-[#D8CBB3]/20 mx-auto mb-4\" />\n              <h3 className=\"text-xl text-[#FFFDF8] mb-2\">Nenhuma m\303\255dia encontrada</h3>\n              <p className=\"text-[#F6F3EC]/50\">Tente buscar por outro termo ou fa\303\247a upload de novas imagens.</p>\n            </div>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
