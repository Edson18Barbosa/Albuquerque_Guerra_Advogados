    replacement_chunks {
      target_content: "import React, { useState } from \'react\';\nimport { User, Award, ArrowUpRight } from \'lucide-react\';\nimport { DetailModal } from \'./DetailModal\';\nimport { TeamMember } from \'../types\';\n\nexport const Team: React.FC = () => {\n  const [selectedMember, setSelectedMember] = useState<TeamMember | null>(null);\n\n  const team: TeamMember[] = [\n    {\n      id: \'renata\',\n      name: \'Renata Albuquerque\',\n      role: \'S\303\263cia e coordenadora das \303\241reas Trabalhista, Previdenci\303\241ria e Consumerista\',\n      bio: \'Advogada formada h\303\241 10 anos, possui p\303\263s-gradua\303\247\303\265es em Direito e Processo do Trabalho e em Direito Previdenci\303\241rio, al\303\251m de especializa\303\247\303\243o em Compliance Trabalhista pela Funda\303\247\303\243o Getulio Vargas.\',\n      image: \'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=800&q=80\',\n      category: \'partner\',\n    },\n    {\n      id: \'claudia\',\n      name: \'Cl\303\241udia Albuquerque\',\n      role: \'S\303\263cia e coordenadora da \303\241rea C\303\255vel\',\n      bio: \'Formada em Economia e em Direito, possui diversas p\303\263s-gradua\303\247\303\265es e especializa\303\247\303\265es em seu curr\303\255culo, unindo vis\303\243o econ\303\264mica e rigor jur\303\255dico na condu\303\247\303\243o de lit\303\255gios e consultorias complexas.\',\n      image: \'https://images.unsplash.com/photo-1580894732475-81643c155609?auto=format&fit=crop&w=800&q=80\',\n      category: \'partner\',\n    },\n    {\n      id: \'joao\',\n      name: \'Jo\303\243o Guerra\',\n      role: \'S\303\263cio\',\n      bio: \'Biografia profissional em atualiza\303\247\303\243o. Atua\303\247\303\243o dedicada \303\240 estrat\303\251gia institucional e supervis\303\243o de consultorias especializadas.\',\n      image: \'https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&w=800&q=80\',\n      category: \'partner\',\n    },\n  ];\n\n  return (\n    <section id=\"equipe\" className=\"py-24 md:py-32 bg-[#101616] relative overflow-hidden\">\n      <div className=\"absolute inset-0 opacity-[0.02] bg-[radial-gradient(#D8CBB3_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none\" />\n\n      <div className=\"max-w-7xl mx-auto px-6 md:px-12 relative z-10\">\n        \n        {/* Section Header */}\n        <div className=\"flex flex-col md:flex-row md:items-end justify-between mb-16 pb-8 border-b border-[#D8CBB3]/20\">\n          <div>\n            <span className=\"text-[#D8CBB3] font-serif text-sm tracking-widest block mb-3\">\n              07 / NOSSA EQUIPE\n            </span>\n            <h2 className=\"text-3xl sm:text-4xl md:text-5xl font-serif text-[#FFFDF8] font-light max-w-2xl leading-tight\">\n              Pessoas, conhecimento e atua\303\247\303\243o <span className=\"text-[#D8CBB3] italic\">pr\303\263xima.</span>\n            </h2>\n          </div>\n          <p className=\"text-[#F6F3EC]/70 text-sm md:text-base max-w-md mt-6 md:mt-0 font-light leading-relaxed\">\n            Profissionais dedicados a construir rela\303\247\303\265es seguras e resultados de excel\303\252ncia.\n          </p>\n        </div>\n\n        {/* Team Grid */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8\">\n          {team.map((member) => (\n            <div\n              key={member.id}\n              className=\"rounded-2xl bg-[#151f1f] border border-[#D8CBB3]/20 hover:border-[#D8CBB3]/60 transition-all duration-500 overflow-hidden flex flex-col justify-between group shadow-xl hover:-translate-y-2\"\n            >\n              {/* Image Container */}\n              <div className=\"relative h-80 overflow-hidden\">\n                <div className=\"absolute inset-0 bg-gradient-to-t from-[#151f1f] via-transparent to-transparent z-10 opacity-70\" />\n                <img\n                  src={member.image}\n                  alt={member.name}\n                  className=\"w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-700 filter contrast-[1.05]\"\n                />\n                <div className=\"absolute top-4 right-4 z-20 px-3 py-1 rounded-full bg-[#101616]/80 backdrop-blur-md border border-[#D8CBB3]/30 text-[11px] text-[#D8CBB3] font-medium uppercase tracking-wider\">\n                  S\303\263cio(a)\n                </div>\n              </div>\n\n              {/* Content Container */}\n              <div className=\"p-8 flex flex-col justify-between flex-grow\">\n                <div>\n                  <h3 className=\"text-2xl font-serif text-[#FFFDF8] mb-2 group-hover:text-[#D8CBB3] transition-colors\">\n                    {member.name}\n                  </h3>\n                  <p className=\"text-[#D8CBB3] text-xs font-semibold tracking-wider uppercase mb-4\">\n                    {member.role}\n                  </p>\n                  <p className=\"text-[#F6F3EC]/70 text-sm font-light leading-relaxed line-clamp-3 mb-6\">\n                    {member.bio}\n                  </p>\n                </div>\n\n                <button\n                  onClick={() => setSelectedMember(member)}\n                  className=\"pt-4 border-t border-white/10 flex items-center justify-between text-sm font-medium text-[#D8CBB3] hover:text-[#FFFDF8] transition-colors group/btn w-full\"\n                >\n                  <span>Conhe\303\247a a trajet\303\263ria</span>\n                  <ArrowUpRight className=\"w-4 h-4 group-hover/btn:translate-x-1 group-hover/btn:-translate-y-1 transition-transform\" />\n                </button>\n              </div>\n            </div>\n          ))}\n        </div>\n\n      </div>\n\n      {/* Member Bio Modal */}\n      <DetailModal\n        isOpen={!!selectedMember}\n        onClose={() => setSelectedMember(null)}\n        title={selectedMember?.name || \'\'}\n        subtitle={selectedMember?.role}\n        content={selectedMember?.bio || \'\'}\n      />\n    </section>\n  );\n};"
      replacement_content: "import React, { useState } from \'react\';\nimport { Award, ArrowUpRight, Scale, Shield } from \'lucide-react\';\nimport { DetailModal } from \'./DetailModal\';\nimport { TeamMember } from \'../types\';\n\nexport const Team: React.FC = () => {\n  const [selectedMember, setSelectedMember] = useState<TeamMember | null>(null);\n\n  const team: TeamMember[] = [\n    {\n      id: \'renata\',\n      name: \'Renata Albuquerque\',\n      role: \'S\303\263cia Fundadora \342\200\242 Coordenadora Trabalhista e C\303\255vel\',\n      bio: \'Advogada especialista em contencioso estrat\303\251gico e consultoria empresarial de alto n\303\255vel. Com vasta experi\303\252ncia em tribunais, lidera a frente trabalhista e civil do escrit\303\263rio com foco em rigor t\303\251cnico, preven\303\247\303\243o de passivos e resultados s\303\263lidos.\',\n      image: \'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=800&q=80\',\n      category: \'partner\',\n    },\n    {\n      id: \'joao\',\n      name: \'Jo\303\243o Guerra\',\n      role: \'S\303\263cio Fundador \342\200\242 Coordenador Estrat\303\251gico e Institucional\',\n      bio: \'S\303\263cio fundador com s\303\263lida atua\303\247\303\243o em lit\303\255gios complexos e estrutura\303\247\303\243o de neg\303\263cios jur\303\255dicos. Combina vis\303\243o estrat\303\251gica refinada e dedica\303\247\303\243o integral \303\240 defesa dos interesses corporativos e individuais de nossos clientes.\',\n      image: \'https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&w=800&q=80\',\n      category: \'partner\',\n    },\n    {\n      id: \'claudia\',\n      name: \'Cl\303\241udia Albuquerque\',\n      role: \'S\303\263cia \342\200\242 Coordenadora Tribut\303\241ria e Societ\303\241ria\',\n      bio: \'Economista e advogada, unindo rigor econ\303\264mico e profundidade jur\303\255dica para solu\303\247\303\265es tribut\303\241rias e societ\303\241rias altamente sofisticadas e seguras.\',\n      image: \'https://images.unsplash.com/photo-1580894732475-81643c155609?auto=format&fit=crop&w=800&q=80\',\n      category: \'partner\',\n    },\n  ];\n\n  return (\n    <section id=\"equipe\" className=\"py-24 md:py-32 bg-[#101616] relative overflow-hidden\">\n      <div className=\"absolute inset-0 opacity-[0.03] bg-[radial-gradient(#D8CBB3_1px,transparent_1px)] [background-size:28px_28px] pointer-events-none\" />\n      <div className=\"absolute top-1/2 left-0 w-96 h-96 bg-[#374544]/20 rounded-full blur-3xl pointer-events-none\" />\n\n      <div className=\"max-w-7xl mx-auto px-6 md:px-12 relative z-10\">\n        \n        {/* Section Header */}\n        <div className=\"flex flex-col md:flex-row md:items-end justify-between mb-16 pb-8 border-b border-[#D8CBB3]/20\">\n          <div>\n            <span className=\"text-[#D8CBB3] font-serif text-sm tracking-widest block mb-3\">\n              05 / S\303\223CIOS E FUNDADORES\n            </span>\n            <h2 className=\"text-3xl sm:text-4xl md:text-5xl font-serif text-[#FFFDF8] font-light max-w-2xl leading-tight\">\n              Lideran\303\247a dedicada \303\240 sua <span className=\"text-[#D8CBB3] italic\">seguran\303\247a jur\303\255dica.</span>\n            </h2>\n          </div>\n          <p className=\"text-[#F6F3EC]/70 text-sm md:text-base max-w-md mt-6 md:mt-0 font-light leading-relaxed\">\n            Renata Albuquerque e Jo\303\243o Guerra lideram uma equipe de profissionais comprometidos com a excel\303\252ncia, \303\251tica e proximidade.\n          </p>\n        </div>\n\n        {/* Team Grid */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8\">\n          {team.map((member) => (\n            <div\n              key={member.id}\n              className=\"rounded-2xl bg-[#151f1f] border border-[#D8CBB3]/25 hover:border-[#D8CBB3]/70 transition-all duration-500 overflow-hidden flex flex-col justify-between group shadow-2xl hover:-translate-y-2 relative\"\n            >\n              {/* Glow accent on hover */}\n              <div className=\"absolute inset-0 bg-[#D8CBB3]/5 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none\" />\n\n              {/* Image Container */}\n              <div className=\"relative h-96 overflow-hidden\">\n                <div className=\"absolute inset-0 bg-gradient-to-t from-[#151f1f] via-transparent to-transparent z-10 opacity-80\" />\n                <img\n                  src={member.image}\n                  alt={member.name}\n                  className=\"w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-700 filter contrast-[1.05]\"\n                />\n                <div className=\"absolute top-4 right-4 z-20 px-3.5 py-1.5 rounded-full bg-[#101616]/85 backdrop-blur-md border border-[#D8CBB3]/40 text-xs text-[#D8CBB3] font-medium uppercase tracking-wider shadow-lg\">\n                  S\303\263cio(a) Fundador(a)\n                </div>\n              </div>\n\n              {/* Content Container */}\n              <div className=\"p-8 flex flex-col justify-between flex-grow relative z-10\">\n                <div>\n                  <h3 className=\"text-2xl font-serif text-[#FFFDF8] mb-2 group-hover:text-[#D8CBB3] transition-colors\">\n                    {member.name}\n                  </h3>\n                  <p className=\"text-[#D8CBB3] text-xs font-semibold tracking-wider uppercase mb-4 leading-relaxed\">\n                    {member.role}\n                  </p>\n                  <p className=\"text-[#F6F3EC]/70 text-sm font-light leading-relaxed line-clamp-3 mb-6\">\n                    {member.bio}\n                  </p>\n                </div>\n\n                <button\n                  onClick={() => setSelectedMember(member)}\n                  className=\"pt-4 border-t border-white/10 flex items-center justify-between text-sm font-medium text-[#D8CBB3] hover:text-[#FFFDF8] transition-colors group/btn w-full\"\n                >\n                  <span>Conhe\303\247a a trajet\303\263ria completa</span>\n                  <ArrowUpRight className=\"w-4 h-4 group-hover/btn:translate-x-1 group-hover/btn:-translate-y-1 transition-transform\" />\n                </button>\n              </div>\n            </div>\n          ))}\n        </div>\n\n      </div>\n\n      {/* Member Bio Modal */}\n      <DetailModal\n        isOpen={!!selectedMember}\n        onClose={() => setSelectedMember(null)}\n        title={selectedMember?.name || \'\'}\n        subtitle={selectedMember?.role}\n        content={selectedMember?.bio || \'\'}\n      />\n    </section>\n  );\n};\n"
    }
