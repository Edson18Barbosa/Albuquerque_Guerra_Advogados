  file_change {
    absolute_path_uri: "file:///src/components/Monogram3D.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\n\nexport const Monogram3D: React.FC = () => {\n  const [rotate, setRotate] = useState({ x: 0, y: 0 });\n\n  const handleMouseMove = (e: React.MouseEvent<HTMLDivElement>) => {\n    const rect = e.currentTarget.getBoundingClientRect();\n    const x = e.clientX - rect.left - rect.width / 2;\n    const y = e.clientY - rect.top - rect.height / 2;\n    setRotate({ x: -y / 10, y: x / 10 });\n  };\n\n  const handleMouseLeave = () => {\n    setRotate({ x: 0, y: 0 });\n  };\n\n  return (\n    <div\n      className=\"relative w-full h-80 md:h-96 flex items-center justify-center perspective-1000 group cursor-pointer\"\n      onMouseMove={handleMouseMove}\n      onMouseLeave={handleMouseLeave}\n    >\n      <div\n        className=\"relative w-56 h-56 md:w-72 md:h-72 rounded-3xl bg-gradient-to-br from-[#374544] via-[#101616] to-[#151f1f] border border-[#D8CBB3]/40 shadow-2xl flex flex-col items-center justify-center p-6 transition-transform duration-200 ease-out\"\n        style={{\n          transform: `rotateX(${rotate.x}deg) rotateY(${rotate.y}deg)`,\n          transformStyle: \'preserve-3d\',\n        }}\n      >\n        {/* Glow background */}\n        <div className=\"absolute inset-0 bg-[#D8CBB3]/10 rounded-3xl blur-xl group-hover:bg-[#D8CBB3]/20 transition-all pointer-events-none\" />\n\n        {/* Orbit ring 1 */}\n        <div className=\"absolute inset-4 border border-[#D8CBB3]/20 rounded-full animate-spin-slow pointer-events-none\" />\n        \n        {/* Orbit ring 2 */}\n        <div className=\"absolute inset-8 border border-dashed border-[#D8CBB3]/30 rounded-full animate-reverse-spin pointer-events-none\" />\n\n        {/* Monogram emblem */}\n        <div className=\"relative z-10 w-24 h-24 md:w-28 md:h-28 rounded-2xl bg-gradient-to-tr from-[#D8CBB3] via-[#EEE8DD] to-[#374544] p-1 shadow-2xl flex items-center justify-center transform translate-z-12\">\n          <div className=\"w-full h-full bg-[#101616] rounded-xl flex items-center justify-center border border-[#D8CBB3]/50\">\n            <span className=\"font-serif text-4xl md:text-5xl font-extrabold text-[#D8CBB3] tracking-tighter\">\n              AG\n            </span>\n          </div>\n        </div>\n\n        <div className=\"relative z-10 mt-6 text-center\">\n          <span className=\"font-serif text-[#FFFDF8] text-sm md:text-base tracking-widest block uppercase\">\n            Albuquerque Guerra\n          </span>\n          <span className=\"text-[#D8CBB3] text-[10px] md:text-xs tracking-[0.3em] uppercase font-sans mt-1 block\">\n            Advogados \342\200\242 Recife\n          </span>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
