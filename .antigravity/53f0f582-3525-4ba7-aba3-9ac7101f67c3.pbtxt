 38 8 Z\" />\n        {/* Right Arch (Column G) */}\n        <path d=\"M46 8 C32 35, 32 65, 46 92 L58 92 C44 65, 44 35, 58 8 Z\" />\n        {/* G Vertical Stem */}\n        <path d=\"M68 8 L79 8 L79 92 L68 92 Z\" />\n        {/* G Horizontal Bar */}\n        <path d=\"M68 56 L94 56 L94 68 L68 68 Z\" />\n      </svg>\n\n      <div className=\"flex flex-col\">\n        <div className=\"flex items-center gap-2 leading-none\">\n          <span className=\"font-serif text-[#FFFDF8] font-semibold text-base md:text-lg tracking-[0.2em]\">\n            ALBUQUERQUE\n          </span>\n          <span className=\"font-serif text-[#FFFDF8] font-semibold text-base md:text-lg tracking-[0.2em]\">\n            GUERRA\n          </span>\n        </div>\n        <span className=\"text-[#D8CBB3] text-[10px] tracking-[0.35em] uppercase font-sans font-medium mt-1\">\n          advogados\n        </span>\n      </div>\n    </div>\n  );\n};\n"
      replacement_content: "import React from \'react\';\n\ninterface LogoProps {\n  className?: string;\n  variant?: \'horizontal\' | \'vertical\' | \'monogram\';\n}\n\nexport const Logo: React.FC<LogoProps> = ({ className = \'\', variant = \'horizontal\' }) => {\n  if (variant === \'vertical\') {\n    return (\n      <img \n        src=\"/logo-vertical.png\" \n        alt=\"Albuquerque Guerra Advogados\" \n        className={`w-32 md:w-40 object-contain ${className}`} \n      />\n    );\n  }\n\n  if (variant === \'monogram\') {\n    return (\n      <img \n        src=\"/logo-monogram.png\" \n        alt=\"AG Advogados\" \n        className={`w-10 h-10 md:w-12 md:h-12 object-contain ${className}`} \n      />\n    );\n  }\n\n  return (\n    <img \n      src=\"/logo-horizontal.png\" \n      alt=\"Albuquerque Guerra Advogados\" \n      className={`h-10 md:h-12 lg:h-14 object-contain ${className}`} \n    />\n  );\n};\n"
