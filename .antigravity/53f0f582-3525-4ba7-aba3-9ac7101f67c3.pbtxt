      replacement_content: "import React from \'react\';\nimport { Scale, CheckCircle2, Award, Sparkles } from \'lucide-react\';\n\nexport const About: React.FC = () => {\n  const indicators = [\n    {\n      title: \'Contencioso\',\n      description: \'Rigour, strategy, and systematic procedural follow-up to achieve the most advantageous resolution.\',\n      icon: Scale,\n    },\n    {\n      title: \'Consultivo\',\n      description: \'Legal orientation for secure, predictable relations that generate positive impact.\',\n      icon: Award,\n    },\n    {\n      title: \'Preven\303\247\303\243o\',\n      description: \'Proactive risk mitigation and consequence analysis before relationships are established.\',\n      icon: CheckCircle2,\n    },\n    {\n      title: \'Impacto Positivo\',\n      description: \'Transforming legal practice into a positive force for business, people, and community.\',\n      icon: Sparkles,\n    },\n  ];\n\n  return (\n    <section id=\"escritorio\" className=\"py-24 md:py-32 bg-[#151f1f] relative overflow-hidden\">\n      <div className=\"absolute top-0 right-0 w-96 h-96 bg-[#374544]/20 rounded-full blur-3xl pointer-events-none\" />\n\n      <div className=\"max-w-7xl mx-auto px-6 md:px-12 relative z-10\">\n        \n        {/* Section Header */}\n        <div className=\"flex flex-col md:flex-row md:items-end justify-between mb-16 pb-8 border-b border-[#D8CBB3]/20\">\n          <div>\n            <span className=\"text-[#D8CBB3] font-serif text-sm tracking-widest block mb-3\">\n              02 / O ESCRIT\303\223RIO\n            </span>\n            <h2 className=\"text-3xl sm:text-4xl md:text-5xl font-serif text-[#FFFDF8] font-light max-w-2xl leading-tight\">\n              Advocacia como instrumento de <span className=\"text-[#D8CBB3] italic\">transforma\303\247\303\243o.</span>\n            </h2>\n          </div>\n          <p className=\"text-[#F6F3EC]/70 text-sm md:text-base max-w-md mt-6 md:mt-0 font-light leading-relaxed\">\n            Unimos t\303\251cnica refinada, proximidade e constante atualiza\303\247\303\243o para entregar resultados seguros e duraderos.\n          </p>\n        </div>\n\n        {/* Main Content Grid */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center mb-20\">\n          \n          {/* Left: Editorial text */}\n          <div className=\"lg:col-span-7 space-y-6 text-[#F6F3EC]/95 text-lg md:text-xl font-light leading-relaxed\">\n            <p className=\"first-letter:text-5xl first-letter:font-serif first-letter:text-[#D8CBB3] first-letter:mr-3 first-letter:float-left\">\n              O <strong className=\"font-semibold text-[#FFFDF8]\">Albuquerque Guerra Advogados</strong> atua no contencioso e no consultivo jur\303\255dico, unindo estrat\303\251gia, acompanhamento pr\303\263ximo e conhecimento em constante atualiza\303\247\303\243o.\n            </p>\n            <p className=\"text-base md:text-lg text-[#F6F3EC]/80 font-light\">\n              Nossa atua\303\247\303\243o busca seguran\303\247a, previsibilidade, vantajosidade e impacto positivo para cada cliente. Cada processo e cada contrato recebem tratamento artesanal, rigoroso e alinhado aos mais altos padr\303\265es da advocacia contempor\303\242nea.\n            </p>\n            <div className=\"pt-4 flex items-center gap-6\">\n              <div className=\"flex flex-col\">\n                <span className=\"font-serif text-3xl text-[#D8CBB3] font-bold\">100%</span>\n                <span className=\"text-xs text-[#F6F3EC]/70 uppercase tracking-wider mt-1\">Dilig\303\252ncia Semanal</span>\n              </div>\n              <div className=\"w-[1px] h-12 bg-[#D8CBB3]/30\" />\n              <div className=\"flex flex-col\">\n                <span className=\"font-serif text-3xl text-[#D8CBB3] font-bold\">Mensal</span>\n                <span className=\"text-xs text-[#F6F3EC]/70 uppercase tracking-wider mt-1\">Relat\303\263rios Transparentes</span>\n              </div>\n              <div className=\"w-[1px] h-12 bg-[#D8CBB3]/30 hidden sm:block\" />\n              <div className=\"hidden sm:flex flex-col\">\n                <span className=\"font-serif text-3xl text-[#D8CBB3] font-bold\">Recife</span>\n                <span className=\"text-xs text-[#F6F3EC]/70 uppercase tracking-wider mt-1\">Atua\303\247\303\243o Nacional</span>\n              </div>\n            </div>\n          </div>\n\n          {/* Right: Office Atmosphere Visual */}\n          <div className=\"lg:col-span-5 relative\">\n            <div className=\"relative rounded-2xl overflow-hidden border border-[#D8CBB3]/30 shadow-2xl\">\n              <div className=\"absolute inset-0 bg-[#374544]/20 mix-blend-multiply z-10\" />\n              <img\n                src=\"https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1000&q=80\"\n                alt=\"Escrit\303\263rio Albuquerque Guerra\"\n                className=\"w-full h-[380px] object-cover hover:scale-105 transition-transform duration-700 filter contrast-[1.05]\"\n              />\n              <div className=\"absolute bottom-4 left-4 right-4 z-20 p-4 bg-[#101616]/90 backdrop-blur-md rounded-xl border border-[#D8CBB3]/20\">\n                <span className=\"text-xs text-[#D8CBB3] font-semibold tracking-wider uppercase\">Sede Principal</span>\n                <p className=\"text-sm text-[#FFFDF8] font-serif mt-1\">Empresarial Camilo Brito \342\200\242 Recife/PE</p>\n              </div>\n            </div>\n          </div>\n\n        </div>\n\n        {/* 4 Conceptual Indicators Grid */}\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6\">\n          {indicators.map((ind, idx) => {\n            const Icon = ind.icon;\n            return (\n              <div\n                key={ind.title}\n                className=\"p-8 rounded-2xl bg-[#101616]/60 border border-[#D8CBB3]/15 hover:border-[#D8CBB3]/40 transition-all duration-300 group flex flex-col justify-between\"\n              >\n                <div>\n                  <div className=\"flex items-center justify-between mb-6\">\n                    <div className=\"w-12 h-12 rounded-xl bg-[#374544] border border-[#D8CBB3]/30 flex items-center justify-center text-[#D8CBB3] group-hover:scale-110 transition-transform\">\n                      <Icon className=\"w-6 h-6\" />\n                    </div>\n                    <span className=\"font-serif text-xl text-[#D8CBB3]/40 group-hover:text-[#D8CBB3] transition-colors\">\n                      0{idx + 1}\n                    </span>\n                  </div>\n                  <h3 className=\"font-serif text-xl text-[#FFFDF8] mb-3 group-hover:text-[#D8CBB3] transition-colors\">\n                    {ind.title}\n                  </h3>\n                  <p className=\"text-[#F6F3EC]/70 text-sm font-light leading-relaxed\">\n                    {ind.description}\n                  </p>\n                </div>\n                <div className=\"mt-6 pt-4 border-t border-white/5 flex items-center justify-between text-xs text-[#D8CBB3]/70\">\n                  <span>Albuquerque Guerra</span>\n                  <span>\342\206\222</span>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n\n      </div>\n    </section>\n  );\n};\n"
    }
