  file_change {
    absolute_path_uri: "file:///src/components/ValuesTriad.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { ShieldCheck, Eye, BookOpen, ArrowRight, Sparkles } from \'lucide-react\';\nimport { DetailModal } from \'./DetailModal\';\nimport { ValueItem } from \'../types\';\n\nexport const ValuesTriad: React.FC = () => {\n  const [activeTab, setActiveTab] = useState<number>(0);\n  const [selectedModalValue, setSelectedModalValue] = useState<ValueItem | null>(null);\n\n  const values: ValueItem[] = [\n    {\n      id: \'diligencia\',\n      number: \'01\',\n      title: \'Dilig\303\252ncia\',\n      subtitle: \'Acompanhamento sistem\303\241tico e constante\',\n      summary: \'Acompanhamento sistem\303\241tico e constante para que aquilo que est\303\241 sob o nosso controle contribua para o andamento do processo.\',\n      fullContent: `Desde o in\303\255cio, sempre fizemos quest\303\243o de sistematizar nossa abordagem no impulsionamento dos processos que nos s\303\243o confiados. N\303\243o admitimos que as a\303\247\303\265es fiquem soltas, \303\240 disposi\303\247\303\243o da boa vontade do \303\223rg\303\243o Julgador. Afinal, se o interessado no andamento do feito \303\251 o nosso cliente, n\303\243o poder\303\255amos deix\303\241-lo \303\240 merc\303\252 da justi\303\247a.\n\nQuando a celeridade \303\251 o interesse, as dilig\303\252ncias s\303\243o realizadas semanalmente.\n\nEm cada processo em que advogamos, do primeiro ao \303\272ltimo dia de tramita\303\247\303\243o, realizamos dilig\303\252ncias semanais em busca do pr\303\263ximo passo. A cada semana, em cada processo, promovemos um novo contato com os serventu\303\241rios da justi\303\247a, auxiliares, chefes de secretaria, assessores e magistrados, sempre de forma sistematizada e mediante procedimentos padronizados.\n\nCom isso, minimizam-se as chances de o processo ficar parado. Se muitas s\303\243o as vari\303\241veis que podem interferir negativamente no andamento processual, como a sobrecarga da justi\303\247a ou a postura adotada pela parte contr\303\241ria, nossa atua\303\247\303\243o n\303\243o pode ser mais uma delas. Aquilo que est\303\241 sob o nosso controle deve contribuir, nunca prejudicar.\n\nCom essa postura, formamos o primeiro de nossos valores: a dilig\303\252ncia. Conhecemos o valor do tempo e sabemos da import\303\242ncia de maximizar o seu aproveitamento.`,\n    },\n    {\n      id: \'transparencia\',\n      number: \'02\',\n      title: \'Transpar\303\252ncia\',\n      subtitle: \'Informa\303\247\303\243o constante para preservar a confian\303\247a\',\n      summary: \'Informa\303\247\303\243o constante para preservar a confian\303\247a e permitir que o cliente acompanhe e planeje os pr\303\263ximos passos.\',\n      fullContent: `Sem exce\303\247\303\243o, cada cliente que nos demanda recebe mensalmente relat\303\263rios com os \303\272ltimos andamentos e com as provid\303\252ncias pendentes. A cada m\303\252s, o destinat\303\241rio de nossos servi\303\247os \303\251 espontaneamente informado, ainda que n\303\243o venha a perguntar, sobre aquilo que foi realizado e sobre aquilo que dever\303\241 ser feito.\n\nDessa forma, mantemos os nossos clientes sempre informados, evitando o elemento surpresa e viabilizando o planejamento de suas decis\303\265es.\n\nAl\303\251m disso, permanecemos \303\240 disposi\303\247\303\243o para responder aos questionamentos e pedidos de informa\303\247\303\243o apresentados.\n\nCom essa postura, evidenciamos o segundo de nossos valores: a transpar\303\252ncia.\n\nTrata-se de um valor necess\303\241rio para retribuir a confian\303\247a que nossos clientes depositam em nossos servi\303\247os. Afinal, enquanto a confian\303\247a est\303\241 sempre presente no ato da contrata\303\247\303\243o, sem transpar\303\252ncia n\303\243o pode haver confian\303\247a.\n\nA dilig\303\252ncia orienta o monitoramento e o impulsionamento semanal dos processos. A transpar\303\252ncia, por sua vez, orienta a apresenta\303\247\303\243o de relat\303\263rios mensais e garante disponibilidade constante para os destinat\303\241rios de nossas atividades. Tudo em prol da retribui\303\247\303\243o e da preserva\303\247\303\243o da confian\303\247a depositada na contrata\303\247\303\243o de nossos servi\303\247os.`,\n    },\n    {\n      id: \'conhecimento\',\n      number: \'03\',\n      title: \'Compromisso com o Conhecimento\',\n      subtitle: \'Aprendizado constante e atualiza\303\247\303\243o cont\303\255nua\',\n      summary: \'O conhecimento jur\303\255dico est\303\241 em constante transforma\303\247\303\243o. Por isso, aprender, pesquisar e se atualizar fazem parte da nossa forma de atuar.\',\n      fullContent: `Nossa atividade est\303\241 em constante transforma\303\247\303\243o. Lidamos diariamente com as mais variadas normas produzidas, alteradas ou revogadas e com as mais diversas decis\303\265es proferidas ou reformadas pelos julgadores e tribunais.\n\nUm entendimento que existia ontem pode j\303\241 n\303\243o existir hoje e talvez volte a existir amanh\303\243. Existe uma l\303\263gica jur\303\255dica e uma ci\303\252ncia por tr\303\241s dessa din\303\242mica, mas o conhecimento com o qual trabalhamos est\303\241 em constante muta\303\247\303\243o.\n\nPor isso, a vontade de aprender, pesquisar e se atualizar \303\251 uma caracter\303\255stica necess\303\241ria e sempre presente em nossa atua\303\247\303\243o. A sede pelo conhecimento, que constitui o terceiro de nossos valores, dirige e orienta nossa atividade, sempre com o prop\303\263sito de construir e entregar a melhor solu\303\247\303\243o ao destinat\303\241rio de nossos servi\303\247os: o cliente.\n\nBuscamos tamb\303\251m acompanhar a evolu\303\247\303\243o tecnol\303\263gica e os impactos que ela produz em nossas atividades. Da padroniza\303\247\303\243o de procedimentos e sistemas operacionais ao uso adequado e supervisionado da intelig\303\252ncia artificial, nossas escolhas s\303\243o sempre voltadas \303\240 entrega do melhor resultado.\n\nO passar do tempo nunca poder\303\241 permitir que fiquemos satisfeitos com o conhecimento at\303\251 ent\303\243o adquirido. N\303\243o admitimos a estagna\303\247\303\243o.\n\nCom isso, completamos a tr\303\255ade de valores que orienta nossa atua\303\247\303\243o: dilig\303\252ncia, transpar\303\252ncia e compromisso com o conhecimento.`,\n    },\n  ];\n\n  const currentVal = values[activeTab];\n\n  return (\n    <section id=\"valores\" className=\"py-24 md:py-32 bg-[#151f1f] relative overflow-hidden\">\n      <div className=\"absolute top-1/2 left-0 w-96 h-96 bg-[#D8CBB3]/5 rounded-full blur-3xl pointer-events-none\" />\n\n      <div className=\"max-w-7xl mx-auto px-6 md:px-12 relative z-10\">\n        \n        {/* Section Header */}\n        <div className=\"text-center max-w-3xl mx-auto mb-16\">\n          <span className=\"text-[#D8CBB3] font-serif text-sm tracking-widest block mb-3\">\n            04 / TR\303\215ADE DE VALORES\n          </span>\n          <h2 className=\"text-3xl sm:text-4xl md:text-5xl font-serif text-[#FFFDF8] font-light mb-6 leading-tight\">\n            Transpar\303\252ncia, dilig\303\252ncia e sede pelo <span className=\"text-[#D8CBB3] italic\">conhecimento.</span>\n          </h2>\n          <p className=\"text-[#F6F3EC]/80 text-base md:text-lg font-light leading-relaxed\">\n            Pautamos nossos procedimentos nesta tr\303\255ade de valores por entendermos que, dessa forma, conseguimos entregar o melhor resultado.\n          </p>\n        </div>\n\n        {/* Tab Buttons Selector */}\n        <div className=\"flex flex-wrap items-center justify-center gap-3 md:gap-4 mb-12\">\n          {values.map((val, idx) => (\n            <button\n              key={val.id}\n              onClick={() => setActiveTab(idx)}\n              className={`px-6 py-4 rounded-2xl text-sm md:text-base font-medium transition-all duration-300 flex items-center gap-3 border ${\n                activeTab === idx\n                  ? \'bg-[#D8CBB3] text-[#101616] border-[#D8CBB3] shadow-lg scale-105\'\n                  : \'bg-[#101616]/60 text-[#F6F3EC] border-[#D8CBB3]/20 hover:border-[#D8CBB3]/60\'\n              }`}\n            >\n              <span className={`text-xs px-2 py-0.5 rounded ${activeTab === idx ? \'bg-[#101616]/20 text-[#101616]\' : \'bg-[#374544] text-[#D8CBB3]\'}`}>\n                {val.number}\n              </span>\n              <span>{val.title}</span>\n            </button>\n          ))}\n        </div>\n\n        {/* Active Value Showcase Card */}\n        <div className=\"p-8 md:p-12 rounded-3xl bg-[#101616]/90 border border-[#D8CBB3]/30 shadow-2xl relative overflow-hidden animate-fadeIn\">\n          <div className=\"absolute top-0 right-0 p-8 opacity-10 text-[#D8CBB3] pointer-events-none hidden md:block\">\n            <span className=\"font-serif text-9xl font-bold\">{currentVal.number}</span>\n          </div>\n\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-center\">\n            <div className=\"lg:col-span-8 space-y-6\">\n              <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#374544] text-[#D8CBB3] text-xs font-semibold tracking-wider uppercase border border-[#D8CBB3]/30\">\n                <Sparkles className=\"w-3.5 h-3.5\" />\n                <span>Valor Fundamental {currentVal.number}</span>\n              </div>\n\n              <h3 className=\"text-3xl md:text-4xl font-serif text-[#FFFDF8]\">\n                {currentVal.title}\n              </h3>\n\n              <p className=\"text-xl font-serif italic text-[#D8CBB3]\">\n                \"{currentVal.subtitle}\"\n              </p>\n\n              <p className=\"text-[#F6F3EC]/90 text-lg font-light leading-relaxed\">\n                {currentVal.summary}\n              </p>\n\n              <div className=\"pt-4 flex flex-wrap items-center gap-4\">\n                <button\n                  onClick={() => setSelectedModalValue(currentVal)}\n                  className=\"px-7 py-3.5 rounded-xl bg-[#D8CBB3] hover:bg-[#FFFDF8] text-[#101616] font-semibold text-sm transition-all shadow-lg flex items-center gap-3 group\"\n                >\n                  <span>Conhe\303\247a este valor em detalhes</span>\n                  <ArrowRight className=\"w-4 h-4 group-hover:translate-x-1 transition-transform\" />\n                </button>\n              </div>\n            </div>\n\n            <div className=\"lg:col-span-4 flex items-center justify-center\">\n              <div className=\"w-full h-64 md:h-80 rounded-2xl overflow-hidden relative border border-[#D8CBB3]/30 shadow-inner\">\n                <img\n                  src={\n                    activeTab === 0\n                      ? \"https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=800&q=80\"\n                      : activeTab === 1\n                      ? \"https://images.unsplash.com/photo-1507679799987-c73779587ccf?auto=format&fit=crop&w=800&q=80\"\n                      : \"https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=800&q=80\"\n                  }\n                  alt={currentVal.title}\n                  className=\"w-full h-full object-cover filter contrast-[1.05]\"\n                />\n                <div className=\"absolute inset-0 bg-gradient-to-t from-[#101616] via-transparent to-transparent opacity-80\" />\n                <div className=\"absolute bottom-4 left-4 right-4 text-center\">\n                  <span className=\"text-xs text-[#D8CBB3] font-serif uppercase tracking-widest\">\n                    Albuquerque Guerra Advogados\n                  </span>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n      </div>\n\n      {/* Modal for full value content */}\n      <DetailModal\n        isOpen={!!selectedModalValue}\n        onClose={() => setSelectedModalValue(null)}\n        title={selectedModalValue?.title || \'\'}\n        subtitle={selectedModalValue?.subtitle}\n        content={selectedModalValue?.fullContent || \'\'}\n      />\n    </section>\n  );\n};\n"
    }
    diff {
      unified_diff {
