    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { ArrowLeft, Save, Image as ImageIcon, Check } from \'lucide-react\';\nimport { Link } from \'react-router-dom\';\n\nexport const AdminEventForm: React.FC = () => {\n  return (\n    <div className=\"space-y-8 animate-fadeIn pb-20\">\n      <div className=\"flex items-center justify-between\">\n        <Link to=\"/admin/events\" className=\"inline-flex items-center gap-2 text-[#F6F3EC]/70 hover:text-[#D8CBB3] transition-colors group\">\n          <ArrowLeft className=\"w-4 h-4 group-hover:-translate-x-1 transition-transform\" />\n          <span>Voltar para eventos</span>\n        </Link>\n        <div className=\"flex gap-4\">\n          <button className=\"px-5 py-2.5 rounded-xl border border-[#D8CBB3]/30 text-[#D8CBB3] hover:bg-[#D8CBB3]/10 font-medium transition-colors\">\n            Salvar rascunho\n          </button>\n          <button className=\"px-5 py-2.5 rounded-xl bg-[#D8CBB3] text-[#101616] font-semibold hover:bg-[#FFFDF8] transition-colors shadow-lg flex items-center gap-2\">\n            <Check className=\"w-4 h-4\" />\n            Publicar no site\n          </button>\n        </div>\n      </div>\n\n      <div>\n        <h1 className=\"text-3xl font-serif text-[#FFFDF8] mb-2\">Adicionar evento</h1>\n        <p className=\"text-[#F6F3EC]/70\">Preencha os detalhes do novo evento.</p>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-8\">\n        <div className=\"lg:col-span-2 space-y-8\">\n          {/* Dados Principais */}\n          <div className=\"bg-[#151f1f] border border-white/10 rounded-3xl p-6 md:p-8\">\n            <h2 className=\"text-xl font-serif text-[#FFFDF8] mb-6 border-b border-white/10 pb-4\">Dados Principais</h2>\n            \n            <div className=\"space-y-6\">\n              <div>\n                <label className=\"block text-sm text-[#F6F3EC]/70 mb-2\">Nome do evento</label>\n                <input type=\"text\" className=\"w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-[#FFFDF8] focus:border-[#D8CBB3]/50 focus:outline-none transition-colors\" />\n              </div>\n              \n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n                <div>\n                  <label className=\"block text-sm text-[#F6F3EC]/70 mb-2\">Data inicial</label>\n                  <input type=\"date\" className=\"w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-[#FFFDF8] focus:border-[#D8CBB3]/50 focus:outline-none transition-colors\" />\n                </div>\n                <div>\n                  <label className=\"block text-sm text-[#F6F3EC]/70 mb-2\">Hor\303\241rio inicial</label>\n                  <input type=\"time\" className=\"w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-[#FFFDF8] focus:border-[#D8CBB3]/50 focus:outline-none transition-colors\" />\n                </div>\n              </div>\n\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n                <div>\n                  <label className=\"block text-sm text-[#F6F3EC]/70 mb-2\">Modalidade</label>\n                  <select className=\"w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-[#FFFDF8] focus:border-[#D8CBB3]/50 focus:outline-none transition-colors appearance-none\">\n                    <option>Presencial</option>\n                    <option>Online</option>\n                    <option>H\303\255brido</option>\n                  </select>\n                </div>\n                <div>\n                  <label className=\"block text-sm text-[#F6F3EC]/70 mb-2\">Categoria</label>\n                  <select className=\"w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-[#FFFDF8] focus:border-[#D8CBB3]/50 focus:outline-none transition-colors appearance-none\">\n                    <option>Palestras</option>\n                    <option>Congressos</option>\n                    <option>Workshops</option>\n                    <option>Cursos</option>\n                  </select>\n                </div>\n              </div>\n\n              <div>\n                <label className=\"block text-sm text-[#F6F3EC]/70 mb-2\">Descri\303\247\303\243o resumida</label>\n                <textarea rows={3} className=\"w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-[#FFFDF8] focus:border-[#D8CBB3]/50 focus:outline-none transition-colors resize-none\"></textarea>\n              </div>\n\n              <div>\n                <label className=\"block text-sm text-[#F6F3EC]/70 mb-2\">Local / Endere\303\247o</label>\n                <input type=\"text\" className=\"w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-[#FFFDF8] focus:border-[#D8CBB3]/50 focus:outline-none transition-colors\" />\n              </div>\n\n              <div>\n                <label className=\"block text-sm text-[#F6F3EC]/70 mb-2\">Link de inscri\303\247\303\243o</label>\n                <input type=\"url\" placeholder=\"https://\" className=\"w-full bg-white/5 border border-white/10 rounded-xl py-3 px-4 text-[#FFFDF8] focus:border-[#D8CBB3]/50 focus:outline-none transition-colors\" />\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <div className=\"space-y-8\">\n          {/* Imagens */}\n          <div className=\"bg-[#151f1f] border border-white/10 rounded-3xl p-6 md:p-8\">\n            <h2 className=\"text-xl font-serif text-[#FFFDF8] mb-6 border-b border-white/10 pb-4\">Artes do Evento</h2>\n            \n            <div className=\"space-y-6\">\n              <div className=\"border-2 border-dashed border-[#D8CBB3]/20 rounded-2xl p-8 flex flex-col items-center justify-center text-center hover:border-[#D8CBB3]/50 hover:bg-white/5 transition-all cursor-pointer group\">\n                <div className=\"w-16 h-16 rounded-full bg-[#D8CBB3]/10 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform\">\n                  <ImageIcon className=\"w-8 h-8 text-[#D8CBB3]\" />\n                </div>\n                <p className=\"text-[#FFFDF8] font-medium mb-1\">Upload da arte principal</p>\n                <p className=\"text-xs text-[#F6F3EC]/50\">O formato ser\303\241 detectado automaticamente (16:9, 4:5, 9:16)</p>\n              </div>\n            </div>\n          </div>\n\n          {/* Configura\303\247\303\265es */}\n          <div className=\"bg-[#151f1f] border border-white/10 rounded-3xl p-6 md:p-8\">\n            <h2 className=\"text-xl font-serif text-[#FFFDF8] mb-6 border-b border-white/10 pb-4\">Configura\303\247\303\265es</h2>\n            \n            <div className=\"space-y-4\">\n              <label className=\"flex items-center gap-3 cursor-pointer\">\n                <input type=\"checkbox\" className=\"w-5 h-5 rounded border-white/20 bg-white/5 accent-[#D8CBB3]\" />\n                <span className=\"text-[#F6F3EC]/80\">Destacar na p\303\241gina inicial</span>\n              </label>\n              \n              <label className=\"flex items-center gap-3 cursor-pointer\">\n                <input type=\"checkbox\" className=\"w-5 h-5 rounded border-white/20 bg-white/5 accent-[#D8CBB3]\" defaultChecked />\n                <span className=\"text-[#F6F3EC]/80\">Mostrar na se\303\247\303\243o de eventos</span>\n              </label>\n              \n              <label className=\"flex items-center gap-3 cursor-pointer\">\n                <input type=\"checkbox\" className=\"w-5 h-5 rounded border-white/20 bg-white/5 accent-[#D8CBB3]\" defaultChecked />\n                <span className=\"text-[#F6F3EC]/80\">Permitir inscri\303\247\303\243o</span>\n              </label>\n              \n              <label className=\"flex items-center gap-3 cursor-pointer\">\n                <input type=\"checkbox\" className=\"w-5 h-5 rounded border-white/20 bg-white/5 accent-[#D8CBB3]\" />\n                <span className=\"text-[#F6F3EC]/80\">Marcar como evento realizado</span>\n              </label>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};"
    }
