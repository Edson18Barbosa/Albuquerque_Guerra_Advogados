    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { Menu, X, ArrowRight, Phone } from \'lucide-react\';\nimport { Logo } from \'./Logo\';\n\nexport const Navbar: React.FC = () => {\n  const [isScrolled, setIsScrolled] = useState(false);\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n\n  useEffect(() => {\n    const handleScroll = () => {\n      if (window.scrollY > 50) {\n        setIsScrolled(true);\n      } else {\n        setIsScrolled(false);\n      }\n    };\n    window.addEventListener(\'scroll\', handleScroll);\n    return () => window.removeEventListener(\'scroll\', handleScroll);\n  }, []);\n\n  const navLinks = [\n    { name: \'O Escrit\303\263rio\', href: \'#escritorio\' },\n    { name: \'\303\201reas de Atua\303\247\303\243o\', href: \'#atuacao\' },\n    { name: \'Nossos Valores\', href: \'#valores\' },\n    { name: \'Miss\303\243o e Vis\303\243o\', href: \'#missao-visao\' },\n    { name: \'Equipe\', href: \'#equipe\' },\n    { name: \'Contato\', href: \'#contato\' },\n  ];\n\n  return (\n    <header\n      className={`fixed top-0 left-0 right-0 z-40 transition-all duration-500 ${\n        isScrolled\n          ? \'bg-[#101616]/90 backdrop-blur-md py-4 border-b border-[#D8CBB3]/15 shadow-2xl\'\n          : \'bg-transparent py-6\'\n      }`}\n    >\n      <div className=\"max-w-7xl mx-auto px-6 md:px-12 flex items-center justify-between\">\n        {/* Logo */}\n        <a href=\"#\" className=\"group\">\n          <Logo />\n        </a>\n\n        {/* Desktop Navigation */}\n        <nav className=\"hidden lg:flex items-center gap-8\">\n          {navLinks.map((link) => (\n            <a\n              key={link.name}\n              href={link.href}\n              className=\"text-sm font-medium text-[#F6F3EC]/80 hover:text-[#D8CBB3] transition-colors tracking-wide relative py-1 after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[1px] after:bg-[#D8CBB3] hover:after:w-full after:transition-all after:duration-300\"\n            >\n              {link.name}\n            </a>\n          ))}\n        </nav>\n\n        {/* Action Button */}\n        <div className=\"hidden md:flex items-center gap-4\">\n          <a\n            href=\"#contato\"\n            className=\"px-5 py-2.5 rounded-full border border-[#D8CBB3]/40 text-[#D8CBB3] hover:bg-[#D8CBB3] hover:text-[#101616] text-sm font-medium tracking-wide transition-all duration-300 flex items-center gap-2 group\"\n          >\n            <span>Fale conosco</span>\n            <ArrowRight className=\"w-4 h-4 group-hover:translate-x-1 transition-transform\" />\n          </a>\n        </div>\n\n        {/* Mobile Menu Button */}\n        <button\n          onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n          className=\"lg:hidden p-2 text-[#F6F3EC] hover:text-[#D8CBB3] transition-colors rounded-lg bg-white/5 border border-white/10\"\n          aria-label=\"Menu\"\n        >\n          {mobileMenuOpen ? <X className=\"w-6 h-6\" /> : <Menu className=\"w-6 h-6\" />}\n        </button>\n      </div>\n\n      {/* Full-screen Mobile Menu */}\n      {mobileMenuOpen && (\n        <div className=\"fixed inset-0 top-0 z-50 bg-[#101616]/98 backdrop-blur-xl flex flex-col justify-between p-8 lg:hidden animate-fadeIn\">\n          <div className=\"flex items-center justify-between border-b border-white/10 pb-6\">\n            <Logo />\n            <button\n              onClick={() => setMobileMenuOpen(false)}\n              className=\"p-2 text-[#F6F3EC] hover:text-[#D8CBB3] rounded-full bg-white/5\"\n            >\n              <X className=\"w-6 h-6\" />\n            </button>\n          </div>\n\n          <div className=\"flex flex-col gap-6 py-8\">\n            {navLinks.map((link) => (\n              <a\n                key={link.name}\n                href={link.href}\n                onClick={() => setMobileMenuOpen(false)}\n                className=\"font-serif text-2xl text-[#F6F3EC] hover:text-[#D8CBB3] transition-colors flex items-center justify-between group\"\n              >\n                <span>{link.name}</span>\n                <ArrowRight className=\"w-5 h-5 opacity-0 group-hover:opacity-100 group-hover:translate-x-2 transition-all text-[#D8CBB3]\" />\n              </a>\n            ))}\n          </div>\n\n          <div className=\"border-t border-white/10 pt-6 flex flex-col gap-4\">\n            <div className=\"flex items-center gap-3 text-sm text-[#F6F3EC]/80\">\n              <Phone className=\"w-4 h-4 text-[#D8CBB3]\" />\n              <span>(81) 3071-8988</span>\n            </div>\n            <a\n              href=\"#contato\"\n              onClick={() => setMobileMenuOpen(false)}\n              className=\"w-full py-3 bg-[#D8CBB3] text-[#101616] text-center font-semibold rounded-xl hover:bg-[#FFFDF8] transition-colors shadow-lg\"\n            >\n              Fale conosco\n            </a>\n          </div>\n        </div>\n      )}\n    </header>\n  );\n};\n"
    }
